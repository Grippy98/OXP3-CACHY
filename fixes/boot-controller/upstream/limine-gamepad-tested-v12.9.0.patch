diff --git a/common/drivers/gamepad_state.c b/common/drivers/gamepad_state.c
new file mode 100644
index 0000000..7362b28
--- /dev/null
+++ b/common/drivers/gamepad_state.c
@@ -0,0 +1,105 @@
+#include <drivers/gamepad_state.h>
+#include <lib/getchar.h>
+
+static void enqueue(struct gamepad_state *state, int key) {
+    if (state->queue_count == GAMEPAD_QUEUE_SIZE) {
+        // A full queue must never acquire a delayed confirmation.
+        return;
+    }
+    size_t tail = (state->queue_head + state->queue_count) % GAMEPAD_QUEUE_SIZE;
+    state->queue[tail] = key;
+    state->queue_count++;
+}
+
+void gamepad_state_reset(struct gamepad_state *state) {
+    *state = (struct gamepad_state){0};
+}
+
+bool gamepad_state_report(struct gamepad_state *state, const void *data, size_t length) {
+    const uint8_t *report = data;
+    if (report == NULL || length < 20 || length > 32
+     || report[0] != 0 || report[1] != 20) {
+        return false;
+    }
+
+    uint16_t buttons = report[2] | (uint16_t)report[3] << 8;
+    int y = report[8] | (unsigned int)report[9] << 8;
+    if (y >= 32768) {
+        y -= 65536;
+    }
+
+    // Only vertical stick motion navigates; horizontal motion cannot boot.
+    if (y >= 12000) {
+        state->stick_direction = GETCHAR_CURSOR_UP;
+    } else if (y <= -12000) {
+        state->stick_direction = GETCHAR_CURSOR_DOWN;
+    } else if ((state->stick_direction == GETCHAR_CURSOR_UP && y < 8000)
+            || (state->stick_direction == GETCHAR_CURSOR_DOWN && y > -8000)) {
+        state->stick_direction = 0;
+    }
+
+    int direction = state->stick_direction;
+    if ((buttons & 3) == 1) {
+        direction = GETCHAR_CURSOR_UP;
+    } else if ((buttons & 3) == 2) {
+        direction = GETCHAR_CURSOR_DOWN;
+    } else if ((buttons & 3) == 3) {
+        direction = 0;
+    } else if ((buttons & 12) == 4) {
+        direction = GETCHAR_GAMEPAD_BACK;
+    } else if ((buttons & 12) == 8) {
+        direction = GETCHAR_GAMEPAD_EXPAND;
+    } else if ((buttons & 12) == 12) {
+        direction = 0;
+    }
+
+    // Require a neutral mapped report after initialisation or disconnection.
+    // A button held while the menu opens must not select an entry.
+    if (!state->armed) {
+        state->buttons = buttons;
+        if ((buttons & 0x300f) == 0 && direction == 0) {
+            state->armed = true;
+        }
+        return true;
+    }
+
+    if (direction != state->direction) {
+        state->direction = direction;
+        state->repeat_ms = 400;
+        if (direction != 0) {
+            enqueue(state, direction);
+        }
+    }
+
+    uint16_t pressed = buttons & ~state->buttons;
+    // Reject simultaneous A/B; neither confirmation nor back should win.
+    if ((buttons & 0x3000) == 0x1000 && (pressed & 0x1000) != 0) {
+        enqueue(state, '\n');
+    } else if ((buttons & 0x3000) == 0x2000 && (pressed & 0x2000) != 0) {
+        enqueue(state, GETCHAR_GAMEPAD_BACK);
+    }
+    state->buttons = buttons;
+    return true;
+}
+
+int gamepad_state_next(struct gamepad_state *state, unsigned int elapsed_ms) {
+    if (state->armed && state->direction != 0) {
+        if (elapsed_ms >= state->repeat_ms) {
+            state->repeat_ms = 120;
+            // Only repeat vertical navigation, never confirmation or back.
+            if (state->direction == GETCHAR_CURSOR_UP
+             || state->direction == GETCHAR_CURSOR_DOWN) {
+                enqueue(state, state->direction);
+            }
+        } else {
+            state->repeat_ms -= elapsed_ms;
+        }
+    }
+    if (state->queue_count == 0) {
+        return 0;
+    }
+    int key = state->queue[state->queue_head];
+    state->queue_head = (state->queue_head + 1) % GAMEPAD_QUEUE_SIZE;
+    state->queue_count--;
+    return key;
+}
diff --git a/common/drivers/gamepad_state.h b/common/drivers/gamepad_state.h
new file mode 100644
index 0000000..9f423e1
--- /dev/null
+++ b/common/drivers/gamepad_state.h
@@ -0,0 +1,25 @@
+#ifndef DRIVERS__GAMEPAD_STATE_H__
+#define DRIVERS__GAMEPAD_STATE_H__
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define GAMEPAD_QUEUE_SIZE 8
+
+struct gamepad_state {
+    bool armed;
+    uint16_t buttons;
+    int stick_direction;
+    int direction;
+    unsigned int repeat_ms;
+    int queue[GAMEPAD_QUEUE_SIZE];
+    size_t queue_head;
+    size_t queue_count;
+};
+
+void gamepad_state_reset(struct gamepad_state *state);
+bool gamepad_state_report(struct gamepad_state *state, const void *data, size_t length);
+int gamepad_state_next(struct gamepad_state *state, unsigned int elapsed_ms);
+
+#endif
diff --git a/common/drivers/gamepad_usb.h b/common/drivers/gamepad_usb.h
new file mode 100644
index 0000000..27a38c8
--- /dev/null
+++ b/common/drivers/gamepad_usb.h
@@ -0,0 +1,56 @@
+#ifndef DRIVERS__GAMEPAD_USB_H__
+#define DRIVERS__GAMEPAD_USB_H__
+
+#include <efi.h>
+#include <stddef.h>
+
+// EFI_USB_IO_PROTOCOL ABI from UEFI 2.11 section 17.2. PicoEFI does not
+// provide it. Unused methods remain function-pointer slots, in ABI order.
+struct gamepad_usb_device_descriptor {
+    UINT8 length, type;
+    UINT16 usb_version;
+    UINT8 device_class, device_subclass, device_protocol, max_packet_size;
+    UINT16 vendor, product, device_version;
+    UINT8 manufacturer, product_string, serial, configurations;
+} __attribute__((packed));
+
+struct gamepad_usb_interface_descriptor {
+    UINT8 length, type, number, alternate, endpoints;
+    UINT8 interface_class, subclass, protocol, interface_string;
+} __attribute__((packed));
+
+struct gamepad_usb_endpoint_descriptor {
+    UINT8 length, type, address, attributes;
+    UINT16 max_packet_size;
+    UINT8 interval;
+} __attribute__((packed));
+
+struct gamepad_usb_io;
+
+typedef EFI_STATUS (EFIAPI *gamepad_usb_callback)(void *, UINTN, void *, UINT32);
+
+struct gamepad_usb_io {
+    EFI_STATUS (EFIAPI *control_transfer)(void);
+    EFI_STATUS (EFIAPI *bulk_transfer)(void);
+    EFI_STATUS (EFIAPI *async_interrupt_transfer)(struct gamepad_usb_io *, UINT8,
+                                                 BOOLEAN, UINTN, UINTN,
+                                                 gamepad_usb_callback, void *);
+    EFI_STATUS (EFIAPI *sync_interrupt_transfer)(void);
+    EFI_STATUS (EFIAPI *isochronous_transfer)(void);
+    EFI_STATUS (EFIAPI *async_isochronous_transfer)(void);
+    EFI_STATUS (EFIAPI *get_device_descriptor)(struct gamepad_usb_io *, struct gamepad_usb_device_descriptor *);
+    EFI_STATUS (EFIAPI *get_config_descriptor)(void);
+    EFI_STATUS (EFIAPI *get_interface_descriptor)(struct gamepad_usb_io *, struct gamepad_usb_interface_descriptor *);
+    EFI_STATUS (EFIAPI *get_endpoint_descriptor)(struct gamepad_usb_io *, UINT8, struct gamepad_usb_endpoint_descriptor *);
+    EFI_STATUS (EFIAPI *get_string_descriptor)(void);
+    EFI_STATUS (EFIAPI *get_supported_languages)(void);
+    EFI_STATUS (EFIAPI *port_reset)(void);
+};
+
+_Static_assert(sizeof(struct gamepad_usb_device_descriptor) == 18, "USB device descriptor ABI");
+_Static_assert(sizeof(struct gamepad_usb_interface_descriptor) == 9, "USB interface descriptor ABI");
+_Static_assert(sizeof(struct gamepad_usb_endpoint_descriptor) == 7, "USB endpoint descriptor ABI");
+_Static_assert(offsetof(struct gamepad_usb_io, async_interrupt_transfer) == 2 * sizeof(void (*)(void)), "USB async method ABI");
+_Static_assert(offsetof(struct gamepad_usb_io, get_endpoint_descriptor) == 9 * sizeof(void (*)(void)), "USB endpoint method ABI");
+
+#endif
