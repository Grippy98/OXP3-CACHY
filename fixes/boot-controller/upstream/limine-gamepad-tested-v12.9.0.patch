diff --git a/common/lib/panic.s2.c b/common/lib/panic.s2.c
index bb9130c..2868f15 100644
--- a/common/lib/panic.s2.c
+++ b/common/lib/panic.s2.c
@@ -14,6 +14,7 @@
 #include <mm/pmm.h>
