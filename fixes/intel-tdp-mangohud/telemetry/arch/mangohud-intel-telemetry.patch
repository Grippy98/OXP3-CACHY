diff --git a/src/intel_fdinfo_memory.h b/src/intel_fdinfo_memory.h
new file mode 100644
index 0000000..1a41405
--- /dev/null
+++ b/src/intel_fdinfo_memory.h
@@ -0,0 +1,32 @@
+#pragma once
+
+#include <map>
+#include <string>
+#include <vector>
+
+inline bool fdinfo_has_value(
+    const std::vector<std::map<std::string, std::string>>& records,
+    const std::string& key)
+{
+    for (const auto& record : records) {
+        auto value = record.find(key);
+        if (value != record.end() && !value->second.empty())
+            return true;
+    }
+    return false;
+}
+
+inline std::string intel_shared_memory_key(
+    const std::string& driver,
+    const std::vector<std::map<std::string, std::string>>& records)
+{
+    const std::string local = driver == "xe" ? "drm-resident-vram0" :
+                              driver == "i915" ? "drm-resident-local0" : "";
+    const std::string shared = driver == "xe" ? "drm-resident-gtt" :
+                               driver == "i915" ? "drm-resident-system0" : "";
+    if (local.empty() || fdinfo_has_value(records, local) ||
+        !fdinfo_has_value(records, shared))
+        return "";
+
+    return shared;
+}
diff --git a/src/intel_pmt.h b/src/intel_pmt.h
new file mode 100644
index 0000000..2c97b3a
--- /dev/null
+++ b/src/intel_pmt.h
@@ -0,0 +1,17 @@
+#pragma once
+
+#include <cstdint>
+
+// Intel-PMT XML PTL/0: Container_15, GT_MAX, bits 56..63, S8.7.0 Celsius.
+// Match the complete layout before interpreting any raw telemetry byte.
+inline bool is_pantherlake_pmt(uint64_t guid, uint64_t size)
+{
+    return guid == 0x03086000 && size == 3352;
+}
+
+inline int pantherlake_gt_max_temperature(unsigned char raw)
+{
+    const int temperature = raw < 128 ? raw : static_cast<int>(raw) - 256;
+    // Implausible samples must not be displayed as a real temperature.
+    return temperature >= 0 && temperature <= 125 ? temperature : -1;
+}
