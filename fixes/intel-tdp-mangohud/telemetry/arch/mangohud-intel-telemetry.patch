+bool GPU_fdinfo::has_hwmon_sensor(const std::string& key) const
+{
+    auto sensor = hwmon_sensors.find(key);
+    return sensor != hwmon_sensors.end() && sensor->second.stream.is_open();
+}
+
+bool GPU_fdinfo::intel_gpu_uses_package_zero() const
+{
+    if (pci_dev != "0000:00:02.0" ||
+        read_line("/sys/class/powercap/intel-rapl:0/name") != "package-0")
+        return false;
+
+    const std::string powercap = "/sys/class/powercap/";
+    for (const auto& dir : ls(powercap.c_str())) {
+        if (dir.find("intel-rapl:") != 0)
+            continue;
+        const std::string name = read_line(powercap + dir + "/name");
+        if (name.find("package-") == 0 && name != "package-0")
+            return false;
+    }
+    return true;
+}
+
+void GPU_fdinfo::find_intel_gpu_rapl_power()
+{
+    // Do not assign a CPU graphics domain to an unrelated PCI graphics card.
+    // Integrated client GPUs use the processor PCI slot; multi-package systems
+    // need an explicit GPU-to-package mapping before this fallback can be used.
+    if (!intel_gpu_uses_package_zero())
+        return;
+
+    const uint64_t time_ns = os_time_get_nano();
+    if (intel_gpu_rapl_last_attempt_ns != 0 &&
+        time_ns - intel_gpu_rapl_last_attempt_ns < 1'000'000'000)
+        return;
+    intel_gpu_rapl_last_attempt_ns = time_ns;
+
+    std::string powercap = "/sys/class/powercap/";
+    auto powercap_dirs = ls(powercap.c_str());
+
+    for (auto& dir : powercap_dirs) {
+        auto path = powercap + dir;
+        auto name = read_line(path + "/name");
+
+        if (dir.find("intel-rapl:0:") != 0 || name != "uncore")
+            continue;
+
+        auto energy_path = path + "/energy_uj";
+        auto energy_stream = std::ifstream(energy_path);
+
+        if (!energy_stream.good()) {
+            SPDLOG_DEBUG(
+                "powercap: Intel GPU RAPL energy is not accessible at {}",
+                energy_path
+            );
+            continue;
+        }
+
+        intel_gpu_rapl_energy_stream = std::move(energy_stream);
+
+        parse_rapl_counter(read_line(path + "/max_energy_range_uj"),
+                           intel_gpu_rapl_max_energy_range_uj);
+
+        SPDLOG_DEBUG("powercap: using Intel GPU RAPL energy at {}", energy_path);
+        return;
+    }
+}
+
+bool GPU_fdinfo::read_intel_gpu_rapl_energy(uint64_t& energy_uj)
+{
+    if (!intel_gpu_rapl_energy_stream.is_open())
+        return false;
+
+    intel_gpu_rapl_energy_stream.clear();
+    intel_gpu_rapl_energy_stream.seekg(0);
+
+    std::string energy;
+    std::getline(intel_gpu_rapl_energy_stream, energy);
+
+    if (energy.empty())
+        return false;
+
+    return parse_rapl_counter(energy, energy_uj);
+}
+
+float GPU_fdinfo::get_intel_gpu_rapl_power_usage()
+{
+    uint64_t energy_uj = 0;
+    if (!read_intel_gpu_rapl_energy(energy_uj))
+        return -1.f;
+
+    return intel_gpu_rapl_sample.sample(energy_uj, os_time_get_nano(),
+                                       intel_gpu_rapl_max_energy_range_uj);
+}
+
+void GPU_fdinfo::find_intel_gpu_pmt_temperature()
+{
+    if (module != "xe" || !intel_gpu_uses_package_zero())
+        return;
+
+    const uint64_t time_ns = os_time_get_nano();
+    if (intel_gpu_pmt_last_attempt_ns != 0 &&
+        time_ns - intel_gpu_pmt_last_attempt_ns < 1'000'000'000)
+        return;
+    intel_gpu_pmt_last_attempt_ns = time_ns;
+
+    const std::string pmt = "/sys/class/intel_pmt/";
+    for (const auto& dir : ls(pmt.c_str())) {
+        const std::string path = pmt + dir;
+        std::string guid_text = read_line(path + "/guid");
+        if (guid_text.find("0x") == 0)
+            guid_text.erase(0, 2);
+        uint64_t guid = 0, size = 0;
+        auto parsed = std::from_chars(guid_text.data(), guid_text.data() + guid_text.size(), guid, 16);
+        if (parsed.ec != std::errc() || parsed.ptr != guid_text.data() + guid_text.size() ||
+            !parse_rapl_counter(read_line(path + "/size"), size) ||
+            !is_pantherlake_pmt(guid, size))
+            continue;
+
+        std::ifstream stream(path + "/telem", std::ios::binary);
+        if (!stream.is_open())
+            continue;
+        intel_gpu_pmt_temperature_stream = std::move(stream);
+        SPDLOG_DEBUG("PMT: using Panther Lake GT_MAX temperature at {}", path + "/telem");
+        return;
+    }
+}
+
+int GPU_fdinfo::get_intel_gpu_pmt_temperature()
+{
+    if (!intel_gpu_pmt_temperature_stream.is_open())
+        return -1;
+    intel_gpu_pmt_temperature_stream.clear();
+    intel_gpu_pmt_temperature_stream.seekg(127);
+    char temperature = 0;
+    if (!intel_gpu_pmt_temperature_stream.read(&temperature, 1))
+        return -1;
+    return pantherlake_gt_max_temperature(static_cast<unsigned char>(temperature));
+}
