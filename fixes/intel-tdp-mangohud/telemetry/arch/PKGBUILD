# Local OXP3 telemetry and MangoApp pacing backports; attribution in ../CREDITS.md.
# Native x86-64 Arch/CachyOS package. No install hooks or privileged build actions.
pkgname=mangohud-onex3
pkgver=0.8.4
pkgrel=3
pkgdesc='MangoHud with Intel OXP3 telemetry and upstream MangoApp frame pacing fix'
arch=('x86_64')
url='https://github.com/flightlessmango/MangoHud'
license=('MIT')
_commit=992103e4fb744897826de04ea00a2f71e7018214
provides=("mangohud=${pkgver}" 'mangoapp')
conflicts=('mangohud' 'mangohud-common' 'mangohud-common-wayland'
           'mangohud-common-x11' 'mangohud-x11' 'mangohud-wayland' 'mangoapp')
# The 32-bit package is deliberately not provided, replaced or removed.
depends=('gcc-libs' 'glibc' 'dbus' 'glfw' 'hicolor-icon-theme' 'libglvnd'
         'libx11' 'libxkbcommon' 'python' 'vulkan-icd-loader' 'wayland')
makedepends=('git' 'glslang' 'libxrandr' 'meson' 'ninja' 'pkgconf' 'python-mako')
optdepends=('gamescope: MangoApp overlay within gamescope'
            'python-matplotlib: optional mangoplot graphing utility'
            'python-numpy: optional mangoplot graphing utility')
options=('!debug')
source=(
  "MangoHud::git+https://github.com/flightlessmango/MangoHud.git#commit=${_commit}"
  'mangohud-intel-telemetry.patch'
  'mangoapp-one-render-per-frame.patch'
  'telemetry_test.cpp'
  'run-tests.sh'
  "imgui-1.91.6.tar.gz::https://github.com/ocornut/imgui/archive/refs/tags/v1.91.6.tar.gz"
  "implot-0.16.zip::https://github.com/epezent/implot/archive/refs/tags/v0.16.zip"
  "implot_0.16-1_patch.zip::https://wrapdb.mesonbuild.com/v2/implot_0.16-1/get_patch"
  "spdlog-1.14.1.tar.gz::https://github.com/gabime/spdlog/archive/refs/tags/v1.14.1.tar.gz"
  "spdlog_1.14.1-1_patch.zip::https://wrapdb.mesonbuild.com/v2/spdlog_1.14.1-1/get_patch"
  "vulkan-headers-1.4.346.tar.gz::https://github.com/KhronosGroup/Vulkan-Headers/archive/v1.4.346.tar.gz"
  "vulkan-utility-libraries-1.4.346.tar.gz::https://github.com/KhronosGroup/Vulkan-Utility-Libraries/archive/v1.4.346.tar.gz"
)
sha256sums=(
