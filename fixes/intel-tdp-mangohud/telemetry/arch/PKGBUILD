noextract=(
  'imgui-1.91.6.tar.gz'
  'implot-0.16.zip'
  'implot_0.16-1_patch.zip'
  'spdlog-1.14.1.tar.gz'
  'spdlog_1.14.1-1_patch.zip'
  'vulkan-headers-1.4.346.tar.gz'
  'vulkan-utility-libraries-1.4.346.tar.gz'
)

prepare() {
  cd "$srcdir/MangoHud"
  [[ $(git rev-parse HEAD) == "$_commit" ]] || return 1
  git apply --check "$srcdir/mangohud-intel-telemetry.patch"
  git apply "$srcdir/mangohud-intel-telemetry.patch"
  git apply --check "$srcdir/mangoapp-one-render-per-frame.patch"
  git apply "$srcdir/mangoapp-one-render-per-frame.patch"
  # Meson verifies these cached archives against the pinned .wrap hashes again.
  mkdir -p subprojects/packagecache
  local archive
  for archive in "${noextract[@]}"; do
    cp -- "$srcdir/$archive" "subprojects/packagecache/$archive"
  done
}

build() {
  [[ ${ONEX3_BUILD_JOBS:-4} =~ ^[1-9][0-9]*$ ]] || { echo "ONEX3_BUILD_JOBS must be a positive integer" >&2; return 1; }
  arch-meson "$srcdir/MangoHud" "$srcdir/build" \
    --libdir=lib --wrap-mode=nodownload \
    -Dappend_libdir_mangohud=true -Dwith_xnvctrl=disabled \
    -Duse_system_spdlog=disabled \
    -Dmangoapp=true -Dmangohudctl=true -Dtests=disabled
  meson compile -C "$srcdir/build" -j "${ONEX3_BUILD_JOBS:-4}"
}

check() {
  bash "$srcdir/run-tests.sh" "$srcdir/MangoHud/src"
}

package() {
  meson install -C "$srcdir/build" --destdir "$pkgdir" --no-rebuild
  install -Dm644 "$srcdir/MangoHud/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # v0.8.4's current imgui wrap does not install this; tolerate old cached wraps.
  rm -f -- "$pkgdir/usr/lib/libimgui.a"
}
