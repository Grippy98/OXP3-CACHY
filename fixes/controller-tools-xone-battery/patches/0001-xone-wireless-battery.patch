diff --git a/backend/src/api/xone.rs b/backend/src/api/xone.rs
new file mode 100644
index 0000000..498ac5f
--- /dev/null
+++ b/backend/src/api/xone.rs
@@ -0,0 +1,351 @@
+//! Read xone's per-client power supplies without opening a HID/GIP device.
+
+use std::{
+    collections::HashSet,
+    fs,
+    path::{Path, PathBuf},
+};
+
+use crate::controller::{BatteryLevel, ConnectionType, Controller, Status};
+use log::debug;
+
+use super::xbox::{MS_VENDOR_ID, XBOX_WIRELESS_RECEIVER_PRODUCT_IDS};
+
+const GAMEPAD_DRIVER: &str = "xone-gip-gamepad";
+
+pub fn controllers() -> Vec<Controller> {
+    controllers_in(Path::new("/sys/class/power_supply"))
+}
+
+fn controllers_in(power_supplies: &Path) -> Vec<Controller> {
+    let mut seen_clients = HashSet::new();
+    sorted_children(power_supplies)
+        .into_iter()
+        .filter_map(|supply| {
+            // Each read can race hot-unplug. A missing or incomplete client
+            // must not prevent other controllers from being reported.
+            let controller = controller_from_supply(&supply)?;
+            let identity = controller.device_path.as_ref()?;
+            if seen_clients.insert(identity.clone()) {
+                Some(controller)
+            } else {
+                None
+            }
+        })
+        .collect()
+}
+
+fn controller_from_supply(supply: &Path) -> Option<Controller> {
+    let supply = supply.canonicalize().ok()?;
+    let client = gamepad_client(&supply)?;
+    let (name, vendor_id, product_id, serial_number) = client_input(&client)?;
+    let status = match read_trimmed(&supply.join("status"))
+        .unwrap_or_default()
+        .to_ascii_lowercase()
+        .as_str()
+    {
+        "charging" => Status::Charging,
+        "discharging" => Status::Discharging,
+        _ => Status::Unknown,
+    };
+    let battery_level = match read_trimmed(&supply.join("capacity_level"))
+        .unwrap_or_default()
+        .to_ascii_lowercase()
+        .as_str()
+    {
+        "critical" | "low" => BatteryLevel::Low,
+        "normal" => BatteryLevel::Normal,
+        "high" => BatteryLevel::High,
+        "full" => BatteryLevel::Full,
+        _ => BatteryLevel::Unknown,
+    };
+    let connection_type = if client.ancestors().any(|ancestor| {
+        read_hex(&ancestor.join("idVendor")) == Some(MS_VENDOR_ID)
+            && read_hex(&ancestor.join("idProduct"))
+                .map(|product| XBOX_WIRELESS_RECEIVER_PRODUCT_IDS.contains(&product))
+                .unwrap_or(false)
+    }) {
+        ConnectionType::Wireless
+    } else {
+        ConnectionType::Usb
+    };
+
+    // Missing battery attributes mean unknown telemetry; a removed supply or
+    // unbound client means this controller no longer belongs in the snapshot.
+    if !supply.is_dir() || gamepad_client(&supply).as_deref() != Some(client.as_path()) {
+        return None;
+    }
+
+    Some(Controller {
+        name,
+        vendor_id,
+        product_id,
+        capacity: None,
+        battery_level: Some(battery_level),
+        connection_type: Some(connection_type),
+        status,
+        bluetooth: false,
+        serial_number,
+        // Separate GIP clients can have identical product IDs and no serial.
+        // Their canonical client paths remain distinct within this snapshot.
+        device_path: Some(client.to_string_lossy().into_owned()),
+    })
+}
+
+fn gamepad_client(supply: &Path) -> Option<PathBuf> {
+    let device = supply.join("device").canonicalize().ok();
+    let start = device.as_deref().unwrap_or(supply);
+    for ancestor in start.ancestors() {
+        if let Ok(driver) = ancestor.join("driver").canonicalize() {
+            // Do not walk past a differently bound device and accidentally
+            // borrow a receiver's or sibling's identity.
+            return (driver.file_name() == Some(GAMEPAD_DRIVER.as_ref())
+                && supply.starts_with(ancestor))
+            .then(|| ancestor.to_path_buf());
+        }
+    }
+    None
+}
+
+fn client_input(client: &Path) -> Option<(String, u16, u16, Option<String>)> {
+    let inputs = client.join("input").canonicalize().ok()?;
+    if !inputs.starts_with(client) {
+        return None;
+    }
+    for input in sorted_children(&inputs) {
+        let Some(input) = input.canonicalize().ok() else {
+            continue;
+        };
+        if input.parent() != Some(inputs.as_path())
+            || !input.file_name()?.to_string_lossy().starts_with("input")
+        {
+            continue;
+        }
+        let (Some(vendor), Some(product), Some(name)) = (
+            read_hex(&input.join("id/vendor")),
+            read_hex(&input.join("id/product")),
+            read_trimmed(&input.join("name")),
+        ) else {
+            continue;
+        };
+        if name.is_empty() {
+            continue;
+        }
+        let serial = read_trimmed(&input.join("uniq")).filter(|value| !value.is_empty());
+        return Some((name, vendor, product, serial));
+    }
+    None
+}
+
+fn sorted_children(path: &Path) -> Vec<PathBuf> {
+    match fs::read_dir(path) {
+        Ok(entries) => {
+            let mut children: Vec<_> = entries.filter_map(Result::ok).map(|e| e.path()).collect();
+            children.sort();
+            children
+        }
+        Err(error) => {
+            debug!(
+                "Cannot read xone discovery directory {}: {error}",
+                path.display()
+            );
+            Vec::new()
+        }
+    }
+}
+
+fn read_trimmed(path: &Path) -> Option<String> {
+    fs::read_to_string(path)
+        .ok()
+        .map(|value| value.trim().to_owned())
+}
+
+fn read_hex(path: &Path) -> Option<u16> {
+    u16::from_str_radix(read_trimmed(path)?.trim_start_matches("0x"), 16).ok()
+}
+
+pub fn has_client_under_usb_device(usb_device: &Path, clients: &[PathBuf]) -> bool {
+    clients.iter().any(|client| client.starts_with(usb_device))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::{
+        os::unix::fs::symlink,
+        sync::atomic::{AtomicUsize, Ordering},
+    };
+
+    static NEXT_FIXTURE: AtomicUsize = AtomicUsize::new(0);
+
+    struct Fixture {
+        root: PathBuf,
+        supplies: PathBuf,
+        usb: PathBuf,
+        driver: PathBuf,
+    }
+
+    impl Fixture {
+        fn new(receiver: Option<u16>) -> Self {
+            let root = std::env::temp_dir().join(format!(
+                "controller-tools-xone-{}-{}",
+                std::process::id(),
+                NEXT_FIXTURE.fetch_add(1, Ordering::Relaxed)
+            ));
+            fs::create_dir(&root).unwrap();
+            let supplies = root.join("class/power_supply");
+            let usb = root.join("devices/usb3/3-2/3-2.3");
+            let driver = root.join("bus/xone-gip/drivers/xone-gip-gamepad");
+            for directory in [&supplies, &usb, &driver] {
+                fs::create_dir_all(directory).unwrap();
+            }
+            fs::write(usb.join("idVendor"), "045e\n").unwrap();
+            fs::write(
+                usb.join("idProduct"),
+                format!("{:04x}\n", receiver.unwrap_or(0x0b12)),
+            )
+            .unwrap();
+            Self {
+                root,
+                supplies,
+                usb,
+                driver,
+            }
+        }
+
+        fn add(&self, index: usize, level: &str, status: &str) -> PathBuf {
+            let client = self.usb.join(format!("3-2.3:1.0/gip0/gip0.{index}"));
+            let input = client.join(format!("input/input{}", index + 39));
+            let supply = client.join(format!("power_supply/gip0.{index}"));
+            fs::create_dir_all(input.join("id")).unwrap();
+            fs::create_dir_all(&supply).unwrap();
+            fs::write(input.join("id/vendor"), "045e\n").unwrap();
+            fs::write(input.join("id/product"), "0b12\n").unwrap();
+            fs::write(input.join("name"), "Xbox Wireless Controller\n").unwrap();
+            fs::write(supply.join("capacity_level"), level).unwrap();
+            fs::write(supply.join("status"), status).unwrap();
+            symlink(&self.driver, client.join("driver")).unwrap();
+            symlink(&client, supply.join("device")).unwrap();
+            symlink(&supply, self.supplies.join(format!("gip0.{index}"))).unwrap();
+            client
+        }
+    }
+
+    impl Drop for Fixture {
+        fn drop(&mut self) {
+            let _ = fs::remove_dir_all(&self.root);
+        }
+    }
+
+    #[test]
+    fn distinct_same_model_clients_use_their_own_battery_and_input_identity() {
+        let fixture = Fixture::new(Some(0x02fe));
+        let first = fixture.add(0, "Low\n", "Discharging\n");
+        let second = fixture.add(1, "Full\n", "Charging\n");
+        // Receiver identity must never substitute for the per-client input ID.
+        fs::create_dir_all(fixture.usb.join("input/input1/id")).unwrap();
+        fs::write(fixture.usb.join("input/input1/id/product"), "02fe\n").unwrap();
+        let controllers = controllers_in(&fixture.supplies);
+        assert_eq!(controllers.len(), 2);
+        assert_ne!(controllers[0].id(), controllers[1].id());
+        assert_eq!(controllers[0].device_path.as_deref(), first.to_str());
+        assert_eq!(controllers[1].device_path.as_deref(), second.to_str());
+        assert!(matches!(
+            controllers[0].battery_level,
+            Some(BatteryLevel::Low)
+        ));
+        assert!(matches!(
+            controllers[1].battery_level,
+            Some(BatteryLevel::Full)
+        ));
+        assert_eq!(controllers[0].status, Status::Discharging);
+        assert_eq!(controllers[1].status, Status::Charging);
+        for controller in controllers {
+            assert_eq!(controller.vendor_id, 0x045e);
+            assert_eq!(controller.product_id, 0x0b12);
+            assert_eq!(controller.capacity, None);
+            assert!(!controller.bluetooth);
+            assert!(matches!(
+                controller.connection_type,
+                Some(ConnectionType::Wireless)
+            ));
+        }
+    }
+
+    #[test]
+    fn unknown_or_missing_telemetry_stays_unknown_without_a_fake_percentage() {
+        let fixture = Fixture::new(Some(0x02e6));
+        let client = fixture.add(0, "unexpected", "Not charging");
+        let supply = client.join("power_supply/gip0.0");
+        for remove_attributes in [false, true] {
+            if remove_attributes {
+                fs::remove_file(supply.join("capacity_level")).unwrap();
+                fs::remove_file(supply.join("status")).unwrap();
+            }
+            let controllers = controllers_in(&fixture.supplies);
+            assert_eq!(controllers.len(), 1);
+            assert_eq!(controllers[0].capacity, None);
+            assert_eq!(controllers[0].status, Status::Unknown);
+            assert!(matches!(
+                controllers[0].battery_level,
+                Some(BatteryLevel::Unknown)
+            ));
+            assert!(matches!(
+                controllers[0].connection_type,
+                Some(ConnectionType::Wireless)
+            ));
+        }
+    }
+
+    #[test]
+    fn removing_or_unbinding_one_client_keeps_the_other() {
+        let fixture = Fixture::new(Some(0x02fe));
+        let first = fixture.add(0, "Normal", "Discharging");
+        let second = fixture.add(1, "High", "Discharging");
+        assert_eq!(controllers_in(&fixture.supplies).len(), 2);
+        fs::remove_file(first.join("driver")).unwrap();
+        assert_eq!(controllers_in(&fixture.supplies).len(), 1);
+        fs::remove_dir_all(&first).unwrap();
+        let controllers = controllers_in(&fixture.supplies);
+        assert_eq!(controllers.len(), 1);
+        assert_eq!(controllers[0].device_path.as_deref(), second.to_str());
+        fs::remove_dir_all(&second).unwrap();
+        assert!(controllers_in(&fixture.supplies).is_empty());
+    }
+
+    #[test]
+    fn a_parent_input_or_other_driver_cannot_supply_a_client_identity() {
+        let fixture = Fixture::new(Some(0x02fe));
+        let client = fixture.add(0, "High", "Discharging");
+        fs::rename(client.join("input"), fixture.usb.join("input")).unwrap();
+        assert!(controllers_in(&fixture.supplies).is_empty());
+        fs::rename(fixture.usb.join("input"), client.join("input")).unwrap();
+        fs::remove_file(client.join("driver")).unwrap();
+        let other_driver = fixture.root.join("bus/xone-gip/drivers/xone-gip-headset");
+        fs::create_dir_all(&other_driver).unwrap();
+        symlink(other_driver, client.join("driver")).unwrap();
+        assert!(controllers_in(&fixture.supplies).is_empty());
+    }
+
+    #[test]
+    fn aliases_are_deduplicated_and_wired_clients_skip_only_their_usb_parent() {
+        let fixture = Fixture::new(None);
+        let client = fixture.add(0, "Normal", "Unknown");
+        symlink(
+            client.join("power_supply/gip0.0"),
+            fixture.supplies.join("duplicate"),
+        )
+        .unwrap();
+        let controllers = controllers_in(&fixture.supplies);
+        assert_eq!(controllers.len(), 1);
+        assert!(matches!(
+            controllers[0].connection_type,
+            Some(ConnectionType::Usb)
+        ));
+        assert!(has_client_under_usb_device(&fixture.usb, &[client.clone()]));
+        assert!(!has_client_under_usb_device(
+            &fixture.usb.with_file_name("3-2.4"),
+            &[client]
+        ));
+    }
+}
