+function harness() {
+  const sockets = [], toasts = [], timers = new Map();
+  let nextTimer = 0;
+  class Socket {
+    constructor() { sockets.push(this); }
+    close() { this.closed = true; this.onclose?.({ reason: 'closed' }); }
+  }
+  const code = ts.transpileModule(readFileSync(new URL('../src/notifications.ts', import.meta.url), 'utf8'), {
+    compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2020 },
+  }).outputText;
+  const context = {
+    exports: {}, WebSocket: Socket,
+    require(name) {
+      if (name === '@decky/api') return { toaster: { toast: value => toasts.push(value) } };
+      if (name === './logger') return { log() {}, error() {} };
+      throw new Error(`Unexpected dependency ${name}`);
+    },
+    setTimeout(fn) { timers.set(++nextTimer, fn); return nextTimer; },
+    clearTimeout(id) { timers.delete(id); },
+  };
+  vm.runInNewContext(code, context);
+  const stop = context.exports.setupNotifications();
+  return { sockets, toasts, timers, stop };
+}
+
+test('browser message events deliver low-battery text; non-text data is ignored', () => {
+  const h = harness();
+  h.sockets[0].onmessage({ type: 'message', data: 'Xbox is low on battery (Low)' });
+  assert.equal(h.toasts.length, 1);
+  assert.equal(h.toasts[0].body, 'Xbox is low on battery (Low)');
+  h.sockets[0].onmessage({ type: 'message', data: new ArrayBuffer(1) });
+  assert.equal(h.toasts.length, 1);
+  h.stop();
+});
+
+test('unloading a plugin closes its socket without scheduling a reconnect', () => {
+  const h = harness();
+  h.stop();
+  assert.equal(h.sockets[0].closed, true);
+  assert.equal(h.timers.size, 0);
+  h.sockets[0].onmessage({ type: 'message', data: 'late alert' });
+  assert.equal(h.toasts.length, 0);
+});
+
+test('unloading clears a pending reconnect and prevents stale callbacks reconnecting', () => {
+  const h = harness();
+  h.sockets[0].onclose({ reason: 'backend restart' });
+  assert.equal(h.timers.size, 1);
+  const retry = [...h.timers.values()][0];
+  h.stop();
+  assert.equal(h.timers.size, 0);
+  retry();
+  assert.equal(h.sockets.length, 1);
+});
