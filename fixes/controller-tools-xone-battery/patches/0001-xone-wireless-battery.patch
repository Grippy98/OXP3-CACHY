new file mode 100644
index 0000000..9fd5734
--- /dev/null
+++ b/src/controllerPresentation.ts
@@ -0,0 +1,74 @@
+import type { IController } from "./types";
+
+export type BatteryIconKind =
+  | "charging"
+  | "empty"
+  | "quarter"
+  | "half"
+  | "threeQuarters"
+  | "full"
+  | "unknown";
+
+export interface BatteryPresentation {
+  label: string | null;
+  icon: BatteryIconKind;
+  description: string;
+}
+
+export function getBatteryPresentation(controller: IController): BatteryPresentation {
+  const charging = controller.status === "charging";
+
+  // Receiver levels describe ranges, not percentages. Even a contradictory
+  // numeric capacity must not turn a coarse report into a precise percentage.
+  if (controller.batteryLevel !== undefined) {
+    let label: string;
+    let icon: BatteryIconKind;
+    switch (controller.batteryLevel) {
+      case "low": label = "Low"; icon = "quarter"; break;
+      case "normal": label = "Normal"; icon = "half"; break;
+      case "high": label = "High"; icon = "threeQuarters"; break;
+      case "full": label = "Full"; icon = "full"; break;
+      default: label = charging ? "Charging" : "Unknown"; icon = "unknown";
+    }
+    return {
+      label,
+      icon: charging ? "charging" : icon,
+      description: charging && label === "Charging" ? "Battery charging"
+        : charging ? `Battery ${label.toLowerCase()}, charging` : `Battery ${label.toLowerCase()}`,
+    };
+  }
+
+  const capacity = controller.capacity;
+  const hasCapacity = typeof capacity === "number" && Number.isFinite(capacity) && capacity >= 0 && capacity <= 100;
+  // The legacy Xbox Bluetooth backend uses zero for failed reads. Preserve
+  // that ambiguity until it can distinguish a real zero from an absent value.
+  const unknownXboxZero = controller.vendorId === 0x045e && getConnectionPresentation(controller).kind === "bluetooth"
+    && capacity === 0 && controller.status === "unknown";
+  if (hasCapacity && !unknownXboxZero) {
+    const icon: BatteryIconKind = capacity === 0 ? "empty"
+      : capacity <= 25 ? "quarter"
+      : capacity <= 50 ? "half"
+      : capacity <= 75 ? "threeQuarters" : "full";
+    return {
+      label: `${capacity}%`,
+      icon: charging ? "charging" : icon,
+      description: `Battery ${capacity}%${charging ? ", charging" : ""}`,
+    };
+  }
+
+  if (charging) return { label: null, icon: "charging", description: "Battery charging" };
+  if (controller.status === "full") return { label: "Full", icon: "full", description: "Battery full" };
+  return { label: "Unknown", icon: "unknown", description: "Battery level unknown" };
+}
+
+export function getConnectionPresentation(controller: IController): {
+  kind: "bluetooth" | "wireless" | "usb";
+  label: string;
+} {
+  if (controller.connectionType === "wireless") {
+    return { kind: "wireless", label: "Xbox Wireless Adapter" };
+  }
+  if (controller.connectionType === "usb") return { kind: "usb", label: "USB" };
+  if (controller.bluetooth) return { kind: "bluetooth", label: "Bluetooth" };
+  return { kind: "usb", label: "USB" };
+}
