+// Node 22.6+: node --experimental-strip-types --test tests/controller-presentation.test.mjs
+import assert from "node:assert/strict";
+import test from "node:test";
+import { getBatteryPresentation, getConnectionPresentation } from "../src/controllerPresentation.ts";
+
+const base = { name: "Controller", vendorId: 0x054c, productId: 1, capacity: null, status: "unknown", bluetooth: false };
+const receiver = { ...base, vendorId: 0x045e, connectionType: "wireless" };
+
+test("receiver levels have readable labels and range icons without invented percentages", () => {
+  for (const [batteryLevel, label, icon] of [
+    ["low", "Low", "quarter"], ["normal", "Normal", "half"],
+    ["high", "High", "threeQuarters"], ["full", "Full", "full"],
+  ]) {
+    for (const capacity of [null, 0, 68, 100]) {
+      const result = getBatteryPresentation({ ...receiver, batteryLevel, capacity });
+      assert.equal(result.label, label);
+      assert.equal(result.icon, icon);
+      assert.ok(!result.description.includes("%"));
+    }
+  }
+});
+
+test("unknown receiver and missing battery values remain neutral", () => {
+  for (const controller of [receiver, { ...receiver, batteryLevel: "unknown" },
+    { ...receiver, batteryLevel: "unknown", capacity: 0 },
+    { ...receiver, batteryLevel: "unrecognized", capacity: 100 }, base]) {
+    const result = getBatteryPresentation(controller);
+    assert.equal(result.label, "Unknown");
+    assert.equal(result.icon, "unknown");
+    assert.ok(!result.description.includes("%"));
+  }
+});
+
+test("precise controllers keep percentages including a real zero", () => {
+  for (const [capacity, icon] of [[0, "empty"], [1, "quarter"], [25, "quarter"],
+    [26, "half"], [50, "half"], [51, "threeQuarters"], [75, "threeQuarters"], [76, "full"], [100, "full"]]) {
+    assert.equal(getBatteryPresentation({ ...base, capacity }).label, `${capacity}%`);
+    assert.equal(getBatteryPresentation({ ...base, capacity }).icon, icon);
+  }
+});
+
+test("malformed precise readings never appear as zero or full batteries", () => {
+  for (const capacity of [null, undefined, -1, 101, NaN, Infinity, "50"]) {
+    const result = getBatteryPresentation({ ...base, capacity });
+    assert.equal(result.icon, "unknown");
+    assert.equal(result.label, "Unknown");
+  }
+});
+
+test("charging and full states do not require a precise capacity", () => {
+  assert.equal(getBatteryPresentation({ ...receiver, batteryLevel: "normal", status: "charging" }).icon, "charging");
+  assert.equal(getBatteryPresentation({ ...receiver, batteryLevel: "normal", status: "charging" }).label, "Normal");
+  assert.equal(getBatteryPresentation({ ...base, status: "charging" }).icon, "charging");
+  assert.equal(getBatteryPresentation({ ...base, status: "full" }).label, "Full");
+  assert.equal(getBatteryPresentation({ ...base, capacity: 50, status: "charging" }).label, "50%");
+});
+
+test("Xbox USB missing battery stays neutral and legacy Bluetooth failure sentinel stays untrusted", () => {
+  const xbox = { ...base, vendorId: 0x045e };
+  const usb = getBatteryPresentation({ ...xbox, connectionType: "usb" });
+  assert.equal(usb.label, "Unknown");
+  assert.equal(usb.icon, "unknown");
+  assert.equal(getBatteryPresentation({ ...xbox, capacity: 100 }).label, "100%");
+  assert.equal(getBatteryPresentation({ ...xbox, bluetooth: true, capacity: 0 }).icon, "unknown");
+  assert.equal(getBatteryPresentation({ ...xbox, bluetooth: true, capacity: 0, status: "discharging" }).label, "0%");
+  assert.equal(getBatteryPresentation({ ...xbox, bluetooth: true, capacity: 60 }).label, "60%");
+  assert.equal(getBatteryPresentation({ ...xbox, connectionType: "usb", bluetooth: true, capacity: 0 }).label, "0%");
+});
+
+test("receiver link is explicitly Xbox Wireless while legacy transports keep their icons", () => {
+  assert.deepEqual(getConnectionPresentation(receiver), { kind: "wireless", label: "Xbox Wireless Adapter" });
+  assert.equal(getConnectionPresentation({ ...receiver, bluetooth: true }).kind, "wireless");
+  assert.deepEqual(getConnectionPresentation({ ...base, bluetooth: true }), { kind: "bluetooth", label: "Bluetooth" });
+  assert.deepEqual(getConnectionPresentation({ ...base, connectionType: "usb", bluetooth: true }), { kind: "usb", label: "USB" });
+  assert.deepEqual(getConnectionPresentation(base), { kind: "usb", label: "USB" });
+});
