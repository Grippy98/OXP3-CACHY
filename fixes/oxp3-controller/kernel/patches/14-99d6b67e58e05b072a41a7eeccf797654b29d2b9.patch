+		ret = oxp_gen_3_rgb_status_store(led, OXP_FEAT_DISABLED, 5, 0);
+		if (ret) {
+			dev_err(led->mc_cdev.led_cdev.dev,
+				"Error: Failed to disable RGB: %i\n", ret);
+			return;
+		}
