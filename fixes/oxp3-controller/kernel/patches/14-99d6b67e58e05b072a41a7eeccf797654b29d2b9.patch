+	for (i = 0; i < cfg->rgb_led_count; i++) {
+		led = &cfg->rgb_leds[i];
+		switch (led->type) {
+		case OXP_RGB_FULL:
+			state = led->state;
+			if (state->effect == OXP_UNKNOWN)
