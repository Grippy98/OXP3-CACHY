+static int oxp_gen_3_rgb_color_set(struct oxp_rgb_led *led)
+{
+	struct led_classdev_mc *mc_cdev = &led->mc_cdev;
+	struct oxp_gen_3_rgb_color_report color_report;
+	u8 brightness = mc_cdev->led_cdev.brightness;
