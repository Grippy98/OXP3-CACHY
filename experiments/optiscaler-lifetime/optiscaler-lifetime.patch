+// Observational GTA-only probe. No pixel reads, clone lookup/creation, state
+// transitions or persistent COM leases; at most 16 distinct UI resource/flag pairs.
+static void ProbeFfxUiResource(const char* site, const FfxApiResource& ui, uint32_t flags,
+                               IFGFeature_Dx12* fg, uint64_t frameId, int frameIndex = -1)
+{
+    if (fg == nullptr || _wcsicmp(Util::ExePath().filename().c_str(), L"GTA5_Enhanced.exe") != 0)
+        return;
+    struct Key { uintptr_t resource; uint32_t flags; };
+    static std::mutex probeMutex;
+    static std::array<Key, 16> seen {};
+    static size_t count = 0;
+    size_t sequence = 0;
+    {
+        std::lock_guard lock(probeMutex);
+        const Key key {reinterpret_cast<uintptr_t>(ui.resource), flags};
+        for (size_t i = 0; i < count; ++i)
+            if (seen[i].resource == key.resource && seen[i].flags == key.flags) return;
+        if (count == seen.size()) return;
+        seen[count++] = key;
+        sequence = count;
+    }
+    static_assert(FFX_FRAMEGENERATION_UI_COMPOSITION_FLAG_USE_PREMUL_ALPHA == 1u);
