diff --git a/OptiScaler/framegen/xefg/XeFG_NativeD3D12.h b/OptiScaler/framegen/xefg/XeFG_NativeD3D12.h
new file mode 100644
index 00000000..f114ffcb
--- /dev/null
+++ b/OptiScaler/framegen/xefg/XeFG_NativeD3D12.h
@@ -0,0 +1,60 @@
+#pragma once
+
+#include <d3d12.h>
+#include <wrl/client.h>
+#include <array>
+#include <cstdint>
+#include <utility>
+
+// Intel SDK inputs only. Never use this helper on the game's presentation chain
+// or overwrite State's application-facing objects with the returned interfaces.
+namespace XeFGNative
+{
+using Microsoft::WRL::ComPtr;
+inline constexpr GUID ReShadeUnwrapped = {0x7f2c9a11, 0x3b4e, 0x4d6a, {0x81,0x2f,0x5e,0x9c,0xd3,0x7a,0x1b,0x42}};
+inline constexpr GUID StreamlineUnwrapped = {0xadec44e2, 0x61f0, 0x45c3, {0xad,0x9f,0x1b,0x37,0x37,0x92,0x84,0xff}};
+
+template <typename T> ComPtr<T> Unwrap(IUnknown* object)
+{
+    if (reinterpret_cast<uintptr_t>(object) <= 0xffff) return {}; // null/legacy SDK sentinel, never QI it
+    ComPtr<IUnknown> current = object;
+    std::array<IUnknown*, 8> visited {};
+    for (size_t depth = 0; depth < visited.size(); ++depth)
+    {
+        visited[depth] = current.Get();
+        ComPtr<IUnknown> next;
+        if (FAILED(current->QueryInterface(ReShadeUnwrapped, (void**)next.GetAddressOf())) || next == nullptr)
+        {
+            next.Reset();
+            current->QueryInterface(StreamlineUnwrapped, (void**)next.GetAddressOf());
+        }
+        if (next == nullptr || next.Get() == current.Get())
+        {
+            ComPtr<T> typed;
+            current.As(&typed);
+            return typed; // owns QI reference; never returns a released borrowed pointer
+        }
+        for (size_t previous = 0; previous <= depth; ++previous)
+            if (visited[previous] == next.Get()) return {}; // cyclic proxy chain
+        current = std::move(next);
+    }
+    return {}; // over-deep proxy chain
+}
+
+inline bool SameIdentity(IUnknown* first, IUnknown* second)
+{
+    if (first == nullptr || second == nullptr) return false;
+    ComPtr<IUnknown> a, b;
+    return SUCCEEDED(first->QueryInterface(IID_PPV_ARGS(a.GetAddressOf()))) &&
+        SUCCEEDED(second->QueryInterface(IID_PPV_ARGS(b.GetAddressOf()))) && a.Get() == b.Get();
+}
+
+inline bool MatchesDevice(ID3D12DeviceChild* child, ID3D12Device* device)
+{
+    if (child == nullptr || device == nullptr) return false;
+    ComPtr<ID3D12Device> parent;
+    if (FAILED(child->GetDevice(IID_PPV_ARGS(parent.GetAddressOf())))) return false;
+    auto nativeParent = Unwrap<ID3D12Device>(parent.Get());
+    return SameIdentity(nativeParent.Get(), device);
+}
+} // namespace XeFGNative
