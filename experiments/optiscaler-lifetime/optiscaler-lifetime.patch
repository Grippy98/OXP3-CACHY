+bool SameRatio(const DXGI_RATIONAL& a, const DXGI_RATIONAL& b)
+{
+    if (a.Numerator == 0 || b.Numerator == 0) return a.Numerator == b.Numerator;
+    return a.Denominator != 0 && b.Denominator != 0 &&
+        uint64_t(a.Numerator) * b.Denominator == uint64_t(b.Numerator) * a.Denominator;
+}
