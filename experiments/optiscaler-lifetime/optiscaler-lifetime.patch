+ffxReturnCode_t TryAdoptGtaSwapchain(ffxContext* context, ffxCreateContextDescHeader* header,
+    IDXGISwapChain4** output, HWND hwnd, const DXGI_SWAP_CHAIN_DESC1& requested,
+    const DXGI_SWAP_CHAIN_FULLSCREEN_DESC* fullscreen, ID3D12CommandQueue* queue)
+{
+    auto& state = State::Instance();
+    auto fg = state.currentFG;
+    if (state.activeFgOutput != FGOutput::XeFG || state.activeFgInput != FGInput::FSRFG ||
+        _wcsicmp(Util::ExePath().filename().c_str(), L"GTA5_Enhanced.exe") != 0 ||
+        fg == nullptr || state.currentFGSwapchain == nullptr || fg->Hwnd() != hwnd)
+        return PASSTHRU_RETURN_CODE;
+
+    auto reject = [](const char* reason)
+    {
+        LOG_ERROR("GTA FFX swapchain adoption rejected: {}; existing chain left intact", reason);
+        return FFX_API_RETURN_ERROR_PARAMETER;
+    };
+    if (context == nullptr || output == nullptr || queue == nullptr || fg->SwapchainContext() == nullptr)
+        return reject("invalid output, queue, or SDK context");
+    // Only the known ABI-version extension is meaningful to this emulated provider.
+    unsigned nextCount = 0;
+    for (auto next = header->pNext; next != nullptr; next = next->pNext)
+    {
+        struct VersionDesc { ffxCreateContextDescHeader header; uint32_t version; };
+        if (++nextCount > 8 || next->type != 0x3000B)
+            return reject("unsupported create extension");
+        const auto version = reinterpret_cast<VersionDesc*>(next)->version;
+        if (!((version >= ((3u << 22) | (1u << 12) | 5u) && version <= ((3u << 22) | (1u << 12) | 7u)) ||
+              version == (4u << 22)))
+            return reject("unsupported swapchain ABI version");
+    }
+    auto requestedQueue = CanonicalQueue(queue);
+    auto existingQueue = CanonicalQueue(fg->GetCommandQueue());
+    if (requestedQueue == nullptr || existingQueue == nullptr || requestedQueue.Get() != existingQueue.Get())
+        return reject("command queue identity differs");
+
+    const auto sdk = state.currentFGSwapchain;
+    auto lease = std::make_shared<OwnedFfxSwapchain>();
+    lease->visible = FGHooks::TakeCapturedFGSwapchain(sdk);
+    lease->sdk = sdk;
+    lease->sdkContext = fg->SwapchainContext();
+    if (lease->visible == nullptr) return reject("no constructor-owned ReShade outer reference");
+    HWND visibleHwnd = nullptr;
+    DXGI_SWAP_CHAIN_DESC1 actual {};
+    DXGI_SWAP_CHAIN_DESC original {};
+    if (FAILED(lease->visible->GetHwnd(&visibleHwnd)) || visibleHwnd != hwnd ||
+        FAILED(lease->visible->GetDesc1(&actual)) || FAILED(lease->visible->GetDesc(&original)))
+        return reject("unable to query API-visible descriptor");
+    // ReShade preserves the application's descriptor before RenoDX upgrades its native HDR format.
+    if (!SameVisibleDesc(requested, actual, hwnd, sdk)) return reject("API-visible descriptors differ");
+    const bool wantsWindowed = fullscreen == nullptr || fullscreen->Windowed;
+    if (bool(original.Windowed) != wantsWindowed) return reject("fullscreen/windowed mode differs");
+    if (!wantsWindowed)
+    {
+        DXGI_SWAP_CHAIN_FULLSCREEN_DESC actualFullscreen {};
+        if (FAILED(lease->visible->GetFullscreenDesc(&actualFullscreen)) ||
+            !SameRatio(fullscreen->RefreshRate, actualFullscreen.RefreshRate) ||
+            fullscreen->ScanlineOrdering != actualFullscreen.ScanlineOrdering ||
+            fullscreen->Scaling != actualFullscreen.Scaling)
+            return reject("fullscreen timing differs");
+    }
+    if (state.currentFGSwapchain != sdk || fg->SwapchainContext() != lease->sdkContext)
+        return reject("SDK context changed during validation");
+    // NEW/FOR_HWND own no old caller reference. Return one new caller reference and
+    // keep the constructor capture as a separate context-owned lease, like native FFX.
+    lease->visible->AddRef();
+    *output = lease->visible;
+    *context = reinterpret_cast<ffxContext>(lease.get());
+    {
+        std::lock_guard lock(ownedFfxMutex);
+        ownedFfxSwapchains.emplace(*context, lease);
+    }
+    ffxBeginUiPacketSession_Dx12FG(sdk);
+    LOG_INFO("GTA FFX adopted API-visible ReShade outer {:X}, SDK {:X}, context {:X}; no recreation or caller Release",
+             (size_t)*output, (size_t)sdk, (size_t)*context);
+    return FFX_API_RETURN_OK;
+}
