+using Microsoft::WRL::ComPtr;
+const GUID kReShadeUnwrappedQueue = {0x7f2c9a11, 0x3b4e, 0x4d6a, {0x81,0x2f,0x5e,0x9c,0xd3,0x7a,0x1b,0x42}};
