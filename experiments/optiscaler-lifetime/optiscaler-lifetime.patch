+class FfxUiPacket final : public IOxp3FfxUiPacket
+{
+    std::atomic<ULONG> references {1};
+    const Oxp3FfxUiSnapshot snapshot;
+    const Microsoft::WRL::ComPtr<ID3D12Resource> resource;
+    const Microsoft::WRL::ComPtr<ID3D12CommandQueue> queue;
+    ~FfxUiPacket() = default;
+  public:
+    FfxUiPacket(const Oxp3FfxUiSnapshot& value, Microsoft::WRL::ComPtr<ID3D12Resource> ui,
+                Microsoft::WRL::ComPtr<ID3D12CommandQueue> gameQueue)
+        : snapshot(value), resource(std::move(ui)), queue(std::move(gameQueue)) {}
+    HRESULT STDMETHODCALLTYPE QueryInterface(REFIID iid, void** output) override
+    {
+        if (output == nullptr) return E_POINTER;
+        *output = nullptr;
+        if (iid != IID_IUnknown && iid != IID_IOxp3FfxUiPacket) return E_NOINTERFACE;
+        *output = static_cast<IOxp3FfxUiPacket*>(this);
+        AddRef();
+        return S_OK;
+    }
+    ULONG STDMETHODCALLTYPE AddRef() override { return references.fetch_add(1, std::memory_order_relaxed) + 1; }
+    ULONG STDMETHODCALLTYPE Release() override
+    {
+        const auto left = references.fetch_sub(1, std::memory_order_acq_rel) - 1;
+        if (left == 0) delete this;
+        return left;
+    }
+    HRESULT STDMETHODCALLTYPE GetSnapshot(Oxp3FfxUiSnapshot* output, uint32_t bytes) override
+    {
+        if (output == nullptr) return E_POINTER;
+        if (bytes < sizeof(snapshot)) return E_INVALIDARG;
+        *output = snapshot;
+        return S_OK;
+    }
+    HRESULT STDMETHODCALLTYPE AcquireUiResource(REFIID iid, void** output) override
+    {
+        if (output == nullptr) return E_POINTER;
+        *output = nullptr;
+        return resource == nullptr ? E_UNEXPECTED : resource->QueryInterface(iid, output);
+    }
+    HRESULT STDMETHODCALLTYPE AcquireCommandQueue(REFIID iid, void** output) override
+    {
+        if (output == nullptr) return E_POINTER;
+        *output = nullptr;
+        return queue == nullptr ? E_UNEXPECTED : queue->QueryInterface(iid, output);
+    }
+};
