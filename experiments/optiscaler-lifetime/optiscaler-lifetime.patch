+struct UiPacketSession
+{
+    IDXGISwapChain* carrier = nullptr; // borrowed; lifecycle calls serialize before physical teardown
+    uint64_t generation = 1;
+    uint64_t publication = 0;
+    uint64_t frameId = 0;
+    uint64_t frameRevision = 0;
+    FfxApiRect2D rect {};
+    bool configured = false;
+    bool live = false;
+    bool interpolationEnabled = false;
+    bool published = false;
+    unsigned logCount = 0;
+};
+static std::mutex uiPacketMutex;
+static UiPacketSession uiPacketSession;
+
+static bool IsGtaUiBridge()
+{
+    return _wcsicmp(Util::ExePath().filename().c_str(), L"GTA5_Enhanced.exe") == 0;
+}
+
+static void RecordUiPacketFrame(uint64_t frameId, const FfxApiRect2D& rect, bool interpolationEnabled)
+{
+    if (!IsGtaUiBridge()) return;
+    std::lock_guard lock(uiPacketMutex);
+    auto carrier = State::Instance().currentFGSwapchain;
+    // A frame update cannot revive a carrier that teardown has marked closed.
+    // Only an explicit physical/FFX session begin may establish a live carrier.
+    if (carrier == nullptr || carrier != uiPacketSession.carrier || !uiPacketSession.live) return;
+    ++uiPacketSession.frameRevision;
+    uiPacketSession.frameId = frameId;
+    uiPacketSession.rect = rect;
+    uiPacketSession.configured = carrier != nullptr;
+    uiPacketSession.interpolationEnabled = interpolationEnabled;
+}
+} // namespace
+
+namespace
+{
+// Requires uiPacketMutex. Physical teardown calls this before releasing its live
+// carrier; asynchronous publishers may clear only after matching their captured epoch.
+static void ClearUiPacketLocked(IDXGISwapChain* carrier, const char* reason, bool preserveFrame)
+{
+    if (carrier != nullptr && carrier == uiPacketSession.carrier && uiPacketSession.live)
+        carrier->SetPrivateDataInterface(OXP3_FFX_UI_PACKET_PROPERTY, nullptr);
+    if (carrier == nullptr || carrier == uiPacketSession.carrier)
+    {
+        if (uiPacketSession.published)
+            LOG_INFO("UI_PACKET clear: {} session={}", reason, uiPacketSession.generation);
+        if (!preserveFrame || carrier == nullptr || carrier != uiPacketSession.carrier)
+        {
+            uiPacketSession.carrier = nullptr;
+            uiPacketSession.configured = false;
+            uiPacketSession.live = false;
+        }
+        uiPacketSession.published = false;
+        uiPacketSession.logCount = 0;
+        ++uiPacketSession.generation;
+        ++uiPacketSession.frameRevision;
+    }
+}
+static void ClearFailedUiPublication(const UiPacketSession& registration, const char* reason)
+{
+    std::lock_guard lock(uiPacketMutex);
+    if (!uiPacketSession.live || registration.carrier != uiPacketSession.carrier ||
+        registration.generation != uiPacketSession.generation ||
+        registration.publication != uiPacketSession.publication)
+        return; // carrier may be gone, or a newer registration already won
+    ClearUiPacketLocked(registration.carrier, reason, true);
+}
+} // namespace
+
+void ffxClearUiPacket_Dx12FG(IDXGISwapChain* carrier, const char* reason, bool preserveFrame)
+{
+    if (!IsGtaUiBridge()) return;
+    std::lock_guard lock(uiPacketMutex);
+    ClearUiPacketLocked(carrier, reason, preserveFrame);
+}
+
+void ffxBeginUiPacketSession_Dx12FG(IDXGISwapChain* carrier)
+{
+    ffxClearUiPacket_Dx12FG(carrier, "new FFX/physical swapchain session");
+    if (!IsGtaUiBridge()) return;
+    std::lock_guard lock(uiPacketMutex);
+    uiPacketSession.carrier = carrier;
+    uiPacketSession.live = carrier != nullptr;
+}
+
+static void PublishFfxUiPacket(const FfxApiResource& ui, uint32_t flags, IFGFeature_Dx12* fg)
+{
+    if (!IsGtaUiBridge() || fg == nullptr) return;
+    auto carrier = State::Instance().currentFGSwapchain;
+    if (ui.resource == nullptr)
+    {
+        ffxClearUiPacket_Dx12FG(carrier, "null FFX UI registration", true);
+        return;
+    }
+    if (carrier == nullptr) return;
+    UiPacketSession registration;
+    Microsoft::WRL::ComPtr<ID3D12CommandQueue> registrationQueue;
+    {
+        std::lock_guard lock(uiPacketMutex);
+        if (carrier != uiPacketSession.carrier || !uiPacketSession.live || !uiPacketSession.configured) return;
+        // Use fg only at the existing FFX callback entry. Own its queue before any
+        // subsequent COM query can delay; never dereference fg after that delay.
+        auto* xefg = dynamic_cast<XeFG_Dx12*>(fg); // virtual IFG base: use checked RTTI, never static downcast
+        if (xefg == nullptr) return;
+        registrationQueue = xefg->AcquireUiPresentationQueue();
+        ++uiPacketSession.publication;
+        registration = uiPacketSession;
+    }
+    // Only resource/queue references cross the ABI. The packet never owns its
+    // carrier swapchain, so attaching it cannot create a swapchain reference cycle.
+    Microsoft::WRL::ComPtr<ID3D12Resource> original;
+    if (FAILED(static_cast<IUnknown*>(ui.resource)->QueryInterface(IID_PPV_ARGS(original.GetAddressOf()))) || original == nullptr)
+    {
+        ClearFailedUiPublication(registration, "UI resource QI failed");
+        return;
+    }
+    auto nativeResource = XeFGNative::Unwrap<ID3D12Resource>(original.Get());
+    auto nativeQueue = XeFGNative::Unwrap<ID3D12CommandQueue>(registrationQueue.Get());
+    Microsoft::WRL::ComPtr<ID3D12Device> queueDevice;
+    if (nativeResource == nullptr || nativeQueue == nullptr ||
+        nativeQueue->GetDesc().Type != D3D12_COMMAND_LIST_TYPE_DIRECT ||
+        FAILED(nativeQueue->GetDevice(IID_PPV_ARGS(queueDevice.GetAddressOf()))) ||
+        !XeFGNative::MatchesDevice(nativeResource.Get(), queueDevice.Get()))
+    {
+        ClearFailedUiPublication(registration, "UI/queue native device mismatch");
+        return;
+    }
+    const auto actual = nativeResource->GetDesc();
+    if (actual.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D || actual.Width > UINT32_MAX || actual.SampleDesc.Count != 1)
+    {
+        ClearFailedUiPublication(registration, "unsupported UI resource description");
+        return;
+    }
+    std::lock_guard lock(uiPacketMutex);
+    if (carrier != uiPacketSession.carrier || carrier != State::Instance().currentFGSwapchain ||
+        registration.generation != uiPacketSession.generation || !uiPacketSession.live ||
+        registration.frameRevision != uiPacketSession.frameRevision ||
+        registration.publication != uiPacketSession.publication || !uiPacketSession.configured)
+        return;
