+static const GUID kReShadeSwapchain = {0x1f445f9f, 0x9887, 0x4c4c, {0x90,0x55,0x4e,0x3b,0xad,0xaf,0xcc,0xa8}};
+static const GUID kReShadeUnwrapped = {0x7f2c9a11, 0x3b4e, 0x4d6a, {0x81,0x2f,0x5e,0x9c,0xd3,0x7a,0x1b,0x42}};
+static std::mutex capturedFGMutex;
