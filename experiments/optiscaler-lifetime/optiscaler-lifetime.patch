+HRESULT FGHooks::hkFGSetPrivateData(IDXGIObject* This, REFGUID Name, UINT DataSize, const void* pData)
+{
+    const auto result = o_FGSetPrivateData(This, Name, DataSize, pData);
+    auto& state = State::Instance();
+    if (FAILED(result) || state.activeFgOutput != FGOutput::XeFG || state.activeFgInput != FGInput::FSRFG ||
+        This != static_cast<IDXGIObject*>(state.currentFGSwapchain) || Name != kReShadeSwapchain ||
+        DataSize != sizeof(void*) || pData == nullptr ||
+        _wcsicmp(Util::ExePath().filename().c_str(), L"GTA5_Enhanced.exe") != 0)
+        return result;
