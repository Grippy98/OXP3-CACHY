+        SUCCEEDED(inner->QueryInterface(IID_PPV_ARGS(&innerIdentity))) &&
+        SUCCEEDED(This->QueryInterface(IID_PPV_ARGS(&sdkIdentity))) && innerIdentity == sdkIdentity;
+    if (innerIdentity != nullptr) innerIdentity->Release();
+    if (sdkIdentity != nullptr) sdkIdentity->Release();
+    if (inner != nullptr) inner->Release();
+    if (!matches)
+    {
+        candidate->Release();
+        LOG_WARN("GTA outer capture rejected: ReShade unwrap does not match current XeFG proxy");
+        return result;
+    }
+    bool captured = false;
+    {
+        std::lock_guard lock(capturedFGMutex);
+        if (capturedFGVisible == nullptr)
+        {
+            capturedFGVisible = candidate;
+            capturedFGSdk = state.currentFGSwapchain;
+            captured = true;
+        }
+    }
+    if (!captured) candidate->Release();
+    else LOG_INFO("GTA captured owned ReShade outer {:X} for XeFG proxy {:X}", (size_t) candidate, (size_t) This);
+    return result;
+}
