+bool SameVisibleDesc(const DXGI_SWAP_CHAIN_DESC1& requested, const DXGI_SWAP_CHAIN_DESC1& actual, HWND hwnd, IDXGISwapChain* sdk)
+{
+    UINT width = requested.Width, height = requested.Height;
+    if (width == 0 || height == 0)
+    {
+        RECT client {};
+        if (!GetClientRect(hwnd, &client) || client.right <= client.left || client.bottom <= client.top) return false;
+        if (width == 0) width = client.right - client.left;
+        if (height == 0) height = client.bottom - client.top;
+    }
+    const bool same = width == actual.Width && height == actual.Height && requested.Format == actual.Format &&
+        requested.Stereo == actual.Stereo && requested.SampleDesc.Count == actual.SampleDesc.Count &&
+        requested.SampleDesc.Quality == actual.SampleDesc.Quality && requested.BufferUsage == actual.BufferUsage &&
+        requested.BufferCount == actual.BufferCount && requested.Scaling == actual.Scaling &&
+        requested.SwapEffect == actual.SwapEffect && SameOpaqueHwndAlpha(requested.AlphaMode, actual.AlphaMode, hwnd, sdk) && requested.Flags == actual.Flags;
+    if (!same)
+        LOG_WARN("GTA adoption descriptor mismatch req={}x{} fmt={} stereo={} samples={}/{} usage={} count={} scaling={} effect={} alpha={} flags={:X}; visible={}x{} fmt={} stereo={} samples={}/{} usage={} count={} scaling={} effect={} alpha={} flags={:X}",
+            width, height, (UINT)requested.Format, requested.Stereo, requested.SampleDesc.Count, requested.SampleDesc.Quality,
+            requested.BufferUsage, requested.BufferCount, (UINT)requested.Scaling, (UINT)requested.SwapEffect, (UINT)requested.AlphaMode, requested.Flags,
+            actual.Width, actual.Height, (UINT)actual.Format, actual.Stereo, actual.SampleDesc.Count, actual.SampleDesc.Quality,
+            actual.BufferUsage, actual.BufferCount, (UINT)actual.Scaling, (UINT)actual.SwapEffect, (UINT)actual.AlphaMode, actual.Flags);
+    return same;
+}
