+void FGHooks::ReleaseOwnedFGSwapchain(IDXGISwapChain4* visible, IDXGISwapChain* sdkSwapchain)
+{
+    if (visible == nullptr)
+        return;
+    ffxClearUiPacket_Dx12FG(sdkSwapchain, "owned outer reference released");
+    const bool wasReleasing = releasingOwnedFG;
+    releasingOwnedFG = true;
+    const auto refs = visible->Release(); // release only the reference this bridge owns
+    releasingOwnedFG = wasReleasing;
+    if (refs == 0)
+    {
+        auto& state = State::Instance();
+        if (state.currentFGSwapchain == sdkSwapchain)
+            state.currentFGSwapchain = nullptr;
+        if (state.currentSwapchain == sdkSwapchain)
+            state.currentSwapchain = nullptr;
+    }
+}
+
+void FGHooks::ReleaseCapturedFGSwapchain()
+{
+    IDXGISwapChain4* visible = nullptr;
+    IDXGISwapChain* sdk = nullptr;
+    {
+        std::lock_guard lock(capturedFGMutex);
+        visible = capturedFGVisible;
+        sdk = capturedFGSdk;
+        capturedFGVisible = nullptr; // clear before Release can re-enter hooks
+        capturedFGSdk = nullptr;
+    }
+    ReleaseOwnedFGSwapchain(visible, sdk);
+}
