+using Microsoft::WRL::ComPtr;
+const GUID kReShadeUnwrappedQueue = {0x7f2c9a11, 0x3b4e, 0x4d6a, {0x81,0x2f,0x5e,0x9c,0xd3,0x7a,0x1b,0x42}};
+const GUID kStreamlineUnwrappedQueue = {0xadec44e2, 0x61f0, 0x45c3, {0xad,0x9f,0x1b,0x37,0x37,0x92,0x84,0xff}};
+
+struct OwnedFfxSwapchain
+{
+    IDXGISwapChain4* visible = nullptr; // exactly one context-owned reference
+    IDXGISwapChain* sdk = nullptr; // borrowed identity kept alive by visible
+    void* sdkContext = nullptr;
+    ~OwnedFfxSwapchain() { FGHooks::ReleaseOwnedFGSwapchain(visible, sdk); }
+};
+std::mutex ownedFfxMutex;
+std::unordered_map<ffxContext, std::shared_ptr<OwnedFfxSwapchain>> ownedFfxSwapchains;
+
+std::shared_ptr<OwnedFfxSwapchain> FindOwnedFfx(ffxContext* context)
+{
+    if (context == nullptr || *context == nullptr) return {};
+    std::lock_guard lock(ownedFfxMutex);
+    const auto it = ownedFfxSwapchains.find(*context);
+    return it == ownedFfxSwapchains.end() ? nullptr : it->second;
+}
+
+ComPtr<IUnknown> CanonicalQueue(IUnknown* object)
+{
+    ComPtr<IUnknown> current = object;
+    // QI owns each temporary; support both current ReShade and Streamline proxies.
+    for (unsigned depth = 0; current != nullptr && depth < 8; ++depth)
+    {
+        ComPtr<IUnknown> next;
+        if (FAILED(current->QueryInterface(kReShadeUnwrappedQueue, (void**)next.GetAddressOf())) || next == nullptr)
+        {
+            next.Reset();
+            current->QueryInterface(kStreamlineUnwrappedQueue, (void**)next.GetAddressOf());
+        }
+        if (next == nullptr) break;
+        ComPtr<IUnknown> a, b;
+        current.As(&a);
+        next.As(&b);
+        if (a.Get() == b.Get()) break;
+        current = std::move(next);
+        if (depth == 7) return {}; // malformed/deep proxy chain: fail closed
+    }
+    ComPtr<IUnknown> identity;
+    if (current != nullptr) current.As(&identity);
+    return identity;
+}
+
+bool SameRatio(const DXGI_RATIONAL& a, const DXGI_RATIONAL& b)
+{
+    if (a.Numerator == 0 || b.Numerator == 0) return a.Numerator == b.Numerator;
+    return a.Denominator != 0 && b.Denominator != 0 &&
+        uint64_t(a.Numerator) * b.Denominator == uint64_t(b.Numerator) * a.Denominator;
+}
+
+// ReShade reconstructs a modified HWND DESC1 from legacy _orig_desc and loses
+// AlphaMode, returning UNSPECIFIED even for the game's opaque IGNORE chain.
+// Normalize only that one-way pair for a non-layered/non-composition HWND, and
+// confirm the native SDK chain itself has no explicit transparency semantics.
+bool SameOpaqueHwndAlpha(DXGI_ALPHA_MODE requested, DXGI_ALPHA_MODE visible, HWND hwnd, IDXGISwapChain* sdk)
+{
+    if (requested == visible) return true;
+    if (requested != DXGI_ALPHA_MODE_IGNORE || visible != DXGI_ALPHA_MODE_UNSPECIFIED || !IsWindow(hwnd))
+        return false;
+    SetLastError(ERROR_SUCCESS);
+    const auto exStyle = GetWindowLongPtrW(hwnd, GWL_EXSTYLE);
+    if ((exStyle == 0 && GetLastError() != ERROR_SUCCESS) ||
+        (exStyle & (WS_EX_LAYERED | WS_EX_NOREDIRECTIONBITMAP)) != 0)
+        return false;
+    ComPtr<IDXGISwapChain1> native;
+    DXGI_SWAP_CHAIN_DESC1 nativeDesc {};
+    HWND nativeHwnd = nullptr;
+    if (sdk == nullptr || FAILED(sdk->QueryInterface(IID_PPV_ARGS(native.GetAddressOf()))) ||
+        FAILED(native->GetHwnd(&nativeHwnd)) || nativeHwnd != hwnd || FAILED(native->GetDesc1(&nativeDesc)) ||
+        (nativeDesc.AlphaMode != DXGI_ALPHA_MODE_IGNORE && nativeDesc.AlphaMode != DXGI_ALPHA_MODE_UNSPECIFIED))
+        return false;
+    LOG_DEBUG("GTA opaque HWND alpha normalized: requested IGNORE, ReShade UNSPECIFIED, native={}",
+              (UINT)nativeDesc.AlphaMode);
+    return true;
+}
+
+bool SameVisibleDesc(const DXGI_SWAP_CHAIN_DESC1& requested, const DXGI_SWAP_CHAIN_DESC1& actual, HWND hwnd, IDXGISwapChain* sdk)
+{
+    UINT width = requested.Width, height = requested.Height;
+    if (width == 0 || height == 0)
+    {
+        RECT client {};
+        if (!GetClientRect(hwnd, &client) || client.right <= client.left || client.bottom <= client.top) return false;
+        if (width == 0) width = client.right - client.left;
+        if (height == 0) height = client.bottom - client.top;
+    }
+    const bool same = width == actual.Width && height == actual.Height && requested.Format == actual.Format &&
+        requested.Stereo == actual.Stereo && requested.SampleDesc.Count == actual.SampleDesc.Count &&
+        requested.SampleDesc.Quality == actual.SampleDesc.Quality && requested.BufferUsage == actual.BufferUsage &&
+        requested.BufferCount == actual.BufferCount && requested.Scaling == actual.Scaling &&
+        requested.SwapEffect == actual.SwapEffect && SameOpaqueHwndAlpha(requested.AlphaMode, actual.AlphaMode, hwnd, sdk) && requested.Flags == actual.Flags;
+    if (!same)
+        LOG_WARN("GTA adoption descriptor mismatch req={}x{} fmt={} stereo={} samples={}/{} usage={} count={} scaling={} effect={} alpha={} flags={:X}; visible={}x{} fmt={} stereo={} samples={}/{} usage={} count={} scaling={} effect={} alpha={} flags={:X}",
+            width, height, (UINT)requested.Format, requested.Stereo, requested.SampleDesc.Count, requested.SampleDesc.Quality,
+            requested.BufferUsage, requested.BufferCount, (UINT)requested.Scaling, (UINT)requested.SwapEffect, (UINT)requested.AlphaMode, requested.Flags,
+            actual.Width, actual.Height, (UINT)actual.Format, actual.Stereo, actual.SampleDesc.Count, actual.SampleDesc.Quality,
+            actual.BufferUsage, actual.BufferCount, (UINT)actual.Scaling, (UINT)actual.SwapEffect, (UINT)actual.AlphaMode, actual.Flags);
+    return same;
+}
