+    IDXGISwapChain4* candidate = nullptr;
+    IUnknown* published = nullptr;
+    memcpy(&published, pData, sizeof(published));
+    // The constructor's initial reference makes this QI safe; no weak-pointer upgrade occurs.
+    if (published == nullptr || FAILED(published->QueryInterface(IID_PPV_ARGS(&candidate))))
