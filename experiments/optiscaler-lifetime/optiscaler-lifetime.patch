+HRESULT FGHooks::hkFGSetPrivateData(IDXGIObject* This, REFGUID Name, UINT DataSize, const void* pData)
+{
+    const auto result = o_FGSetPrivateData(This, Name, DataSize, pData);
+    auto& state = State::Instance();
+    if (FAILED(result) || state.activeFgOutput != FGOutput::XeFG || state.activeFgInput != FGInput::FSRFG ||
+        This != static_cast<IDXGIObject*>(state.currentFGSwapchain) || Name != kReShadeSwapchain ||
+        DataSize != sizeof(void*) || pData == nullptr ||
+        _wcsicmp(Util::ExePath().filename().c_str(), L"GTA5_Enhanced.exe") != 0)
+        return result;
+
+    HMODULE caller = nullptr;
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                           reinterpret_cast<LPCWSTR>(_ReturnAddress()), &caller) ||
+        GetProcAddress(caller, "ReShadeVersion") == nullptr)
+        return result;
+
+    IDXGISwapChain4* candidate = nullptr;
+    IUnknown* published = nullptr;
+    memcpy(&published, pData, sizeof(published));
+    // The constructor's initial reference makes this QI safe; no weak-pointer upgrade occurs.
+    if (published == nullptr || FAILED(published->QueryInterface(IID_PPV_ARGS(&candidate))))
+        return result;
+    IUnknown* inner = nullptr;
+    IUnknown* innerIdentity = nullptr;
+    IUnknown* sdkIdentity = nullptr;
+    const bool matches = SUCCEEDED(candidate->QueryInterface(kReShadeUnwrapped, (void**)&inner)) && inner != nullptr &&
+        SUCCEEDED(inner->QueryInterface(IID_PPV_ARGS(&innerIdentity))) &&
+        SUCCEEDED(This->QueryInterface(IID_PPV_ARGS(&sdkIdentity))) && innerIdentity == sdkIdentity;
+    if (innerIdentity != nullptr) innerIdentity->Release();
+    if (sdkIdentity != nullptr) sdkIdentity->Release();
+    if (inner != nullptr) inner->Release();
+    if (!matches)
+    {
+        candidate->Release();
+        LOG_WARN("GTA outer capture rejected: ReShade unwrap does not match current XeFG proxy");
+        return result;
+    }
+    bool captured = false;
+    {
+        std::lock_guard lock(capturedFGMutex);
+        if (capturedFGVisible == nullptr)
+        {
+            capturedFGVisible = candidate;
+            capturedFGSdk = state.currentFGSwapchain;
+            captured = true;
+        }
+    }
+    if (!captured) candidate->Release();
+    else LOG_INFO("GTA captured owned ReShade outer {:X} for XeFG proxy {:X}", (size_t) candidate, (size_t) This);
+    return result;
+}
