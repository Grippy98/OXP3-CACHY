+    value.magic = OXP3_FFX_UI_MAGIC;
+    value.version = OXP3_FFX_UI_VERSION;
+    value.byteSize = sizeof(value);
+    value.active = 1; // UI composition can still be needed while interpolation is paused/disabled.
+    value.session = registration.generation;
+    value.frameId = registration.frameId;
+    value.publicationId = registration.publication;
+    value.uiFlags = flags;
+    value.ffxState = ui.state;
+    value.d3d12State = static_cast<uint32_t>(GetD3D12State(static_cast<FfxApiResourceState>(ui.state)));
+    value.ffxFormat = ui.description.format;
+    value.ffxType = ui.description.type;
+    value.width = static_cast<uint32_t>(actual.Width);
+    value.height = actual.Height;
+    value.mipCount = actual.MipLevels;
+    value.nativeDxgiFormat = actual.Format;
+    value.rectLeft = registration.rect.left;
+    value.rectTop = registration.rect.top;
+    value.rectWidth = registration.rect.width;
+    value.rectHeight = registration.rect.height;
+    value.declaredWidth = ui.description.width;
+    value.declaredHeight = ui.description.height;
+    value.declaredFlags = ui.description.flags;
+    value.declaredUsage = ui.description.usage;
+    value.interpolationEnabled = registration.interpolationEnabled;
+    Microsoft::WRL::ComPtr<IOxp3FfxUiPacket> packet;
+    packet.Attach(new (std::nothrow) FfxUiPacket(value, std::move(original), std::move(nativeQueue)));
+    if (packet == nullptr)
+    {
+        carrier->SetPrivateDataInterface(OXP3_FFX_UI_PACKET_PROPERTY, nullptr);
+        uiPacketSession.published = false;
+        return;
+    }
+    // Serialize attachment with the lifecycle clears. Packet methods and its
+    // destructor never acquire uiPacketMutex; no borrowed UI pointer is retained.
+    const auto result = carrier->SetPrivateDataInterface(OXP3_FFX_UI_PACKET_PROPERTY, packet.Get());
+    uiPacketSession.published = SUCCEEDED(result);
+    if (FAILED(result)) carrier->SetPrivateDataInterface(OXP3_FFX_UI_PACKET_PROPERTY, nullptr);
+    if (uiPacketSession.logCount++ < 8)
+        LOG_INFO("UI_PACKET publish session={} publication={} frame={} carrier={:X} format={} size={}x{} flags={:X} ffxState={:X} nativeState={:X} interpolation={} result={:X}",
+                 value.session, value.publicationId, value.frameId, (size_t)carrier, value.nativeDxgiFormat,
+                 value.width, value.height, value.uiFlags, value.ffxState, value.d3d12State,
+                 value.interpolationEnabled, (UINT)result);
+}
