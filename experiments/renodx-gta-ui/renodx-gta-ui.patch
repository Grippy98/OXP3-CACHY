--- /dev/null
+++ b/src/games/gtav-enhanced/hud_composition.hpp
@@ -0,0 +1,338 @@
+/*
+ * Copyright (C) 2026 Grippy98
+ * SPDX-License-Identifier: MIT
+ */
+#pragma once
+
+#include <d3d12.h>
+#include <dxgi1_4.h>
+#include <wrl/client.h>
+#include <array>
+#include <cstdint>
+#include <deque>
+#include <memory>
+#include <shared_mutex>
+#include <sstream>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+#include "../../mods/swapchain.hpp"
+#include "../../utils/data.hpp"
+#include "../../utils/resource.hpp"
+#include "./oxp3_ffx_ui_packet.h"
+
+namespace gtav_hdr_ui {
+using Microsoft::WRL::ComPtr;
+
+static const float* gamma_correction = nullptr;
+static const float* graphics_white_nits = nullptr;
+static constexpr GUID RESHADE_UNWRAPPED = {0x7f2c9a11, 0x3b4e, 0x4d6a, {0x81, 0x2f, 0x5e, 0x9c, 0xd3, 0x7a, 0x1b, 0x42}};
+static constexpr GUID STREAMLINE_UNWRAPPED = {0xadec44e2, 0x61f0, 0x45c3, {0xad, 0x9f, 0x1b, 0x37, 0x37, 0x92, 0x84, 0xff}};
+
+template <typename Interface>
+ComPtr<Interface> NativeInterface(IUnknown* object) {
+  if (reinterpret_cast<uintptr_t>(object) <= 0xffff) return {};
+  ComPtr<IUnknown> current = object;
+  std::array<IUnknown*, 8> visited = {};
+  for (size_t depth = 0; depth < visited.size(); ++depth) {
+    visited[depth] = current.Get();
+    ComPtr<IUnknown> next;
+    if (FAILED(current->QueryInterface(RESHADE_UNWRAPPED, reinterpret_cast<void**>(next.GetAddressOf())))) {
+      next.Reset();
+      current->QueryInterface(STREAMLINE_UNWRAPPED, reinterpret_cast<void**>(next.GetAddressOf()));
+    }
+    if (next == nullptr || next.Get() == current.Get()) {
+      ComPtr<Interface> result;
+      current.As(&result);
+      return result;
+    }
+    for (size_t previous = 0; previous <= depth; ++previous) {
+      if (visited[previous] == next.Get()) return {};
+    }
+    current = std::move(next);
+  }
+  return {};
+}
+
+static bool SameIdentity(IUnknown* first, IUnknown* second) {
+  if (first == nullptr || second == nullptr) return false;
+  ComPtr<IUnknown> a, b;
+  return SUCCEEDED(first->QueryInterface(IID_PPV_ARGS(a.GetAddressOf())))
+         && SUCCEEDED(second->QueryInterface(IID_PPV_ARGS(b.GetAddressOf()))) && a.Get() == b.Get();
+}
+
+struct FrameLease {
+  uint64_t fence_value = 0;
+  ComPtr<IOxp3FfxUiPacket> packet;
+  ComPtr<ID3D12Resource> clone;
+  ComPtr<ID3D12Resource> scene;
+  ComPtr<ID3D12Resource> back_buffer;
+};
+
+struct HudSurface {
+  ComPtr<ID3D12Resource> resource;
+  bool shader_readable = false;
+};
+
+// ReShade 6.8 DXGISwapChain::on_present/on_reset both hold this queue's mutex
+// while invoking addon callbacks; fields below are only used in those callbacks.
+struct HudState {
+  uint64_t publication = 0;
+  uint64_t fence_value = 0;
+  uint32_t messages = 0;
+  bool stopped = false;
+  ComPtr<ID3D12CommandQueue> queue;
+  reshade::api::command_queue* api_queue = nullptr;  // ReShade swapchain owns it through destroy_swapchain.
+  ComPtr<ID3D12Fence> fence;
+  std::deque<FrameLease> frames;
+  std::unordered_map<uint64_t, HudSurface> surfaces;
+  std::vector<renodx::utils::draw::SwapchainProxyPass*> quarantined_passes;
+  std::vector<HANDLE> quarantined_events;
+};
+static renodx::utils::data::ParallelNodeHashMap<reshade::api::swapchain*, std::shared_ptr<HudState>, std::shared_mutex> states;
+
+static void Log(HudState* state, const char* message) {
+  if (state->messages >= 16) return;
+  ++state->messages;
+  reshade::log::message(reshade::log::level::info, message);
+}
+
+static bool Render(renodx::utils::draw::SwapchainProxyPass* pass,
+                   reshade::api::swapchain* swapchain, reshade::api::command_queue* queue) {
+  const auto back_buffer = swapchain->get_current_back_buffer();
+  reshade::api::resource scene_clone = {};
+  renodx::utils::resource::GetResourceInfo(back_buffer, [&](const renodx::utils::resource::ResourceInfo& info) {
+    if (!info.destroyed) scene_clone = info.clone;
+  });
+  // The GTA shader always declares two SRVs and b14. Reject before PSO creation
+  // rather than falling back to a one-SRV call if the proven scene clone is absent.
+  if (scene_clone.handle == 0) return false;
+
+  std::array<reshade::api::resource, 1> additional_resources = {scene_clone};
+  std::array<float, 4> constants = {};
+  std::shared_ptr<HudState> state;
+  states.lazy_emplace_l(swapchain, [&](auto& entry) { state = entry.second; }, [&](const auto& constructor) {
+                         state = std::make_shared<HudState>();
+                         constructor(swapchain, state); });
+  if (const auto found = state->surfaces.find(back_buffer.handle); found != state->surfaces.end()) {
+    additional_resources[0] = {reinterpret_cast<uintptr_t>(found->second.resource.Get())};
+  }
+  if (state->fence != nullptr) {
+    const auto completed = state->fence->GetCompletedValue();
+    if (completed == UINT64_MAX) state->stopped = true;
+    while (!state->frames.empty() && state->frames.front().fence_value != 0
+           && state->frames.front().fence_value <= completed) {
+      state->frames.pop_front();
+    }
+  }
+  // A failed retirement signal is not permission to submit more work. Returning
+  // success preserves the pass until checked teardown can retire or quarantine it.
+  if (state->stopped) return true;
+
+  ComPtr<IOxp3FfxUiPacket> packet;
+  ComPtr<ID3D12Resource> ui_clone;
+  Oxp3FfxUiSnapshot snapshot = {};
+  do {
+    if (state->frames.size() >= 16 || queue->get_device()->get_api() != reshade::api::device_api::d3d12) break;
+    auto* carrier = reinterpret_cast<IDXGISwapChain*>(static_cast<uintptr_t>(swapchain->get_native()));
+    ComPtr<IUnknown> property;
+    UINT property_size = sizeof(IUnknown*);
+    if (FAILED(carrier->GetPrivateData(OXP3_FFX_UI_PACKET_PROPERTY, &property_size, property.GetAddressOf()))
+        || property == nullptr || FAILED(property.As(&packet))
+        || FAILED(packet->GetSnapshot(&snapshot, sizeof(snapshot)))) break;
+    if (snapshot.magic != OXP3_FFX_UI_MAGIC || snapshot.version != OXP3_FFX_UI_VERSION
+        || snapshot.byteSize != sizeof(snapshot) || snapshot.active != 1
+        || snapshot.session == 0 || snapshot.publicationId == 0
+        // Producer serials are process-global and never reset on a new FFX session.
+        || snapshot.publicationId <= state->publication) break;
+
+    // The first canary is deliberately restricted to the observed source/view contract.
+    if (snapshot.width != 1920 || snapshot.height != 1200 || snapshot.mipCount != 1
+        || snapshot.nativeDxgiFormat != DXGI_FORMAT_B8G8R8A8_UNORM || snapshot.ffxFormat != 14
+        || snapshot.uiFlags != (OXP3_FFX_UI_PREMULTIPLIED | OXP3_FFX_UI_DOUBLE_BUFFERED)
+        || snapshot.d3d12State != (D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE | D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE)
+        || snapshot.rectLeft != 0 || snapshot.rectTop != 0
+        || (snapshot.rectWidth != 0 && snapshot.rectWidth != snapshot.width)
+        || (snapshot.rectHeight != 0 && snapshot.rectHeight != snapshot.height)
+        || gamma_correction == nullptr || *gamma_correction != 1.f) {
+      Log(state.get(), "[OXP3 HUD] unsupported UI contract; original scene conversion retained");
+      break;
+    }
+    auto native_device = NativeInterface<ID3D12Device>(reinterpret_cast<IUnknown*>(static_cast<uintptr_t>(swapchain->get_device()->get_native())));
+    auto native_queue = NativeInterface<ID3D12CommandQueue>(reinterpret_cast<IUnknown*>(static_cast<uintptr_t>(queue->get_native())));
+    ComPtr<ID3D12CommandQueue> registered_queue;
+    ComPtr<ID3D12Resource> registered_ui;
+    if (FAILED(packet->AcquireCommandQueue(IID_PPV_ARGS(registered_queue.GetAddressOf())))
+        || FAILED(packet->AcquireUiResource(IID_PPV_ARGS(registered_ui.GetAddressOf())))) break;
+    auto packet_queue = NativeInterface<ID3D12CommandQueue>(registered_queue.Get());
+    auto native_ui = NativeInterface<ID3D12Resource>(registered_ui.Get());
+    ComPtr<ID3D12Device> queue_device, ui_device;
+    if (native_device == nullptr || native_queue == nullptr || native_ui == nullptr
+        || native_queue->GetDesc().Type != D3D12_COMMAND_LIST_TYPE_DIRECT
+        || !SameIdentity(native_queue.Get(), packet_queue.Get())
+        || FAILED(native_queue->GetDevice(IID_PPV_ARGS(queue_device.GetAddressOf())))
+        || FAILED(native_ui->GetDevice(IID_PPV_ARGS(ui_device.GetAddressOf())))
+        || !SameIdentity(native_device.Get(), NativeInterface<ID3D12Device>(queue_device.Get()).Get())
+        || !SameIdentity(native_device.Get(), NativeInterface<ID3D12Device>(ui_device.Get()).Get())) {
+      Log(state.get(), "[OXP3 HUD] native queue/device identity mismatch; UI skipped");
+      break;
+    }
+    const auto ui_desc = native_ui->GetDesc();
+    const auto back_buffer_desc = swapchain->get_device()->get_resource_desc(back_buffer);
+    if (ui_desc.Format != DXGI_FORMAT_B8G8R8A8_UNORM || ui_desc.Width != snapshot.width
+        || ui_desc.Height != snapshot.height || ui_desc.SampleDesc.Count != 1
+        || back_buffer_desc.texture.format != reshade::api::format::r10g10b10a2_unorm
+        || back_buffer_desc.texture.width != snapshot.width || back_buffer_desc.texture.height != snapshot.height) break;
+
+    std::vector<uint64_t> views;
+    renodx::utils::resource::GetResourceInfo({reinterpret_cast<uintptr_t>(native_ui.Get())},
+                                             [&](const renodx::utils::resource::ResourceInfo& info) {
+                                               if (info.destroyed || !info.clone_enabled || info.clone.handle == 0 || info.is_swap_chain
+                                                   || info.device != swapchain->get_device()
+                                                   || info.desc.texture.format != reshade::api::format::b8g8r8a8_unorm
+                                                   || info.clone_desc.texture.format != reshade::api::format::r16g16b16a16_float) return;
+                                               ui_clone = reinterpret_cast<ID3D12Resource*>(static_cast<uintptr_t>(info.clone.handle));
+                                               views.assign(info.resource_view_handles.begin(), info.resource_view_handles.end());
+                                             });
+    if (ui_clone == nullptr) {
+      Log(state.get(), "[OXP3 HUD] registered UI has no existing live FP16 Reno clone; UI skipped");
+      break;
+    }
+    bool unorm_rtv = false, srgb_rtv = false;
+    for (const auto view : views) {
+      renodx::utils::resource::GetResourceViewInfo({view}, [&](const renodx::utils::resource::ResourceViewInfo& info) {
+        if (info.destroyed || info.is_clone || info.usage != reshade::api::resource_usage::render_target) return;
+        unorm_rtv = unorm_rtv || info.desc.format == reshade::api::format::b8g8r8a8_unorm;
+        srgb_rtv = srgb_rtv || info.desc.format == reshade::api::format::b8g8r8a8_unorm_srgb;
+      });
+    }
+    if (!unorm_rtv || srgb_rtv) {
+      Log(state.get(), "[OXP3 HUD] original UI UNORM-only RTV contract unverified; UI skipped");
+      break;
+    }
+    const auto clone_desc = ui_clone->GetDesc();
+    if (clone_desc.Format != DXGI_FORMAT_R16G16B16A16_FLOAT || clone_desc.Width != snapshot.width
+        || clone_desc.Height != snapshot.height || clone_desc.SampleDesc.Count != 1) break;
+    ComPtr<ID3D12Device> clone_device;
+    if (FAILED(ui_clone->GetDevice(IID_PPV_ARGS(clone_device.GetAddressOf())))
+        || !SameIdentity(native_device.Get(), NativeInterface<ID3D12Device>(clone_device.Get()).Get())) break;
+    auto* command_list = queue->get_immediate_command_list();
+    if (command_list == nullptr) break;
+    if (state->queue != nullptr && !SameIdentity(state->queue.Get(), native_queue.Get())) break;
+    if (state->fence == nullptr) {
+      if (FAILED(native_device->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(state->fence.GetAddressOf())))) break;
+      state->queue = native_queue;
+      state->api_queue = queue;
+    }
+    auto& surface = state->surfaces[back_buffer.handle];
+    if (surface.resource == nullptr) {
+      auto snapshot_desc = clone_desc;
+      snapshot_desc.Flags = D3D12_RESOURCE_FLAG_NONE;
+      const D3D12_HEAP_PROPERTIES heap = {.Type = D3D12_HEAP_TYPE_DEFAULT, .CreationNodeMask = 1, .VisibleNodeMask = 1};
+      if (FAILED(native_device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &snapshot_desc,
+                                                        D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(surface.resource.GetAddressOf())))) break;
+      surface.resource->SetName(L"OXP3 GTA registered UI snapshot");
+    }
+    const reshade::api::resource clone_resource = {reinterpret_cast<uintptr_t>(ui_clone.Get())};
+    const reshade::api::resource snapshot_resource = {reinterpret_cast<uintptr_t>(surface.resource.Get())};
+    command_list->barrier(clone_resource, reshade::api::resource_usage::shader_resource,
+                          reshade::api::resource_usage::copy_source);
+    if (surface.shader_readable) {
+      command_list->barrier(snapshot_resource, reshade::api::resource_usage::shader_resource,
+                            reshade::api::resource_usage::copy_dest);
+    }
+    command_list->copy_resource(clone_resource, snapshot_resource);
+    command_list->barrier(clone_resource, reshade::api::resource_usage::copy_source,
+                          reshade::api::resource_usage::shader_resource);
+    command_list->barrier(snapshot_resource, reshade::api::resource_usage::copy_dest,
+                          reshade::api::resource_usage::shader_resource);
+    surface.shader_readable = true;
+    state->publication = snapshot.publicationId;
+    additional_resources[0] = snapshot_resource;
+    constants[0] = 1.f;
+    std::ostringstream message;
+    message << "[OXP3 HUD] live FP16 clone, encoded-PM gamma2.2 BT709 hypothesis; UI white="
+            << (graphics_white_nits != nullptr ? *graphics_white_nits : 0.f)
+            << ", frame=" << snapshot.frameId << ", publication=" << snapshot.publicationId;
+    Log(state.get(), message.str().c_str());
+  } while (false);
+
+  const bool rendered = pass->Render(swapchain, queue, nullptr, additional_resources, constants, 14, 50);
+  if (constants[0] != 0.f) {
+    // Submit this pass before placing its retirement marker on the same native queue.
+    queue->flush_immediate_command_list();
+    FrameLease lease = {
+        .packet = std::move(packet),
+        .clone = std::move(ui_clone),
+        .scene = reinterpret_cast<ID3D12Resource*>(static_cast<uintptr_t>(scene_clone.handle)),
+        .back_buffer = reinterpret_cast<ID3D12Resource*>(static_cast<uintptr_t>(back_buffer.handle)),
+    };
+    const auto value = ++state->fence_value;
+    if (SUCCEEDED(state->queue->Signal(state->fence.Get(), value))) {
+      lease.fence_value = value;
+    } else {
+      state->stopped = true;
+      Log(state.get(), "[OXP3 HUD] retirement signal failed; GPU leases retained and composition stopped");
+    }
+    state->frames.push_back(std::move(lease));
+  }
+  return rendered;
+}
+
+static void OnDestroySwapchain(reshade::api::swapchain* swapchain, bool resize) {
+  std::shared_ptr<HudState> state;
+  states.if_contains(swapchain, [&](const auto& entry) {
+    state = entry.second;
+  });
+  if (state != nullptr && (!state->frames.empty() || !state->surfaces.empty())) {
+    // ReShade's void wait_idle can return without completing a failed signal. Prove
+    // this queue's retirement with our own checked fence before releasing any lease.
+    state->api_queue->flush_immediate_command_list();
+    const auto value = ++state->fence_value;
+    bool retired = false;
+    if (SUCCEEDED(state->queue->Signal(state->fence.Get(), value))) {
+      auto completed = state->fence->GetCompletedValue();
+      retired = completed != UINT64_MAX && completed >= value;
+      if (!retired) {
+        std::unique_ptr<void, decltype(&CloseHandle)> event(CreateEventW(nullptr, FALSE, FALSE, nullptr), CloseHandle);
+        if (event != nullptr && SUCCEEDED(state->fence->SetEventOnCompletion(value, event.get()))) {
+          if (WaitForSingleObject(event.get(), 5000) == WAIT_OBJECT_0) {
+            completed = state->fence->GetCompletedValue();
+            retired = completed != UINT64_MAX && completed >= value;
+          }
+          if (!retired) state->quarantined_events.push_back(event.release());
+        }
+      }
+    }
+    if (!retired) {
+      state->stopped = true;
+      auto* data = renodx::utils::data::Get<renodx::mods::swapchain::DeviceData>(swapchain->get_device());
+      if (data != nullptr) {
+        const std::unique_lock lock(data->mutex);
+        for (const auto& [buffer, proxy] : data->swapchain_proxy_passes) {
+          state->quarantined_passes.push_back(proxy);
+        }
+        data->swapchain_proxy_passes.clear();
+      }
+      // Deliberately no static destructor: unproved GPU work must not lose its COM,
+      // descriptor or pipeline leases during addon unload. The OS reclaims them at exit.
+      static auto* retained_states = new std::vector<std::shared_ptr<HudState>>();
+      static std::shared_mutex retained_mutex;
+      {
+        const std::unique_lock lock(retained_mutex);
+        retained_states->push_back(state);
+      }
+      reshade::log::message(reshade::log::level::error,
+                            "[OXP3 HUD] GPU retirement unproved; resources and proxy passes quarantined until process exit");
+      states.erase(swapchain);
+      return;
+    }
+    state->frames.clear();
+    state->surfaces.clear();
+  }
+  if (!resize) {
+    states.erase(swapchain);
+  }
+}
+}  // namespace gtav_hdr_ui
