--- /dev/null
+++ b/src/games/gtav-enhanced/oxp3_ffx_ui_packet.h
@@ -0,0 +1,68 @@
+#pragma once
+
+// OXP3 GTA FFX UI bridge, ABI v1. MIT; copyright (c) 2026 Grippy98.
+// Producer: OptiScaler. Consumer: the maintained GTA RenoDX addon.
+#include <unknwn.h>
+#include <cstdint>
+
+inline constexpr uint32_t OXP3_FFX_UI_MAGIC = 0x4955584f; // little-endian "OXUI"
+inline constexpr uint32_t OXP3_FFX_UI_VERSION = 1;
+inline constexpr uint32_t OXP3_FFX_UI_PREMULTIPLIED = 1;
+inline constexpr uint32_t OXP3_FFX_UI_DOUBLE_BUFFERED = 2;
+
+// IDXGIObject::SetPrivateDataInterface property; GetPrivateData returns an AddRef'd IUnknown.
+inline constexpr GUID OXP3_FFX_UI_PACKET_PROPERTY =
+    {0x8e5b201f, 0x8e48, 0x49c4, {0xb3,0x51,0x88,0x55,0xd3,0xe5,0x42,0x96}};
+inline constexpr GUID IID_IOxp3FfxUiPacket =
+    {0xb53df145, 0xdc25, 0x4c89, {0x9b,0x86,0x3e,0xd2,0x41,0x87,0x65,0x61}};
+
+#pragma pack(push, 8)
+struct Oxp3FfxUiSnapshot
+{
+    uint32_t magic;
+    uint32_t version;
+    uint32_t byteSize;
+    uint32_t active; // live nonnull UI registration; independent of interpolationEnabled
+    uint64_t session;
+    uint64_t frameId; // FFX's frame ID, not Opti's resettable local frame count
+    uint32_t uiFlags;
+    uint32_t ffxState;
+    uint32_t ffxFormat;
+    uint32_t ffxType;
+    uint32_t width; // actual native UI resource width/height
+    uint32_t height;
+    uint32_t mipCount;
+    uint32_t nativeDxgiFormat;
+    int32_t rectLeft;
+    int32_t rectTop;
+    uint32_t rectWidth;
+    uint32_t rectHeight;
+    uint32_t declaredWidth;
+    uint32_t declaredHeight;
+    uint32_t declaredFlags;
+    uint32_t declaredUsage;
+    uint32_t d3d12State; // converted native state; ffxState is a DIFFERENT enum
+    uint32_t interpolationEnabled; // latest FFX request; false can still require UI on the real frame
+    uint64_t publicationId; // monotonic UI-registration serial, independent of repeated/reset FFX frame IDs
+};
+#pragma pack(pop)
+static_assert(sizeof(Oxp3FfxUiSnapshot) == 112);
+
+struct __declspec(uuid("b53df145-dc25-4c89-9b86-3ed241876561")) IOxp3FfxUiPacket : IUnknown
+{
+    virtual HRESULT STDMETHODCALLTYPE GetSnapshot(Oxp3FfxUiSnapshot* output, uint32_t outputBytes) = 0;
+    // Successful Acquire calls return a caller-owned QI reference; no borrowed pointer crosses this ABI.
+    virtual HRESULT STDMETHODCALLTYPE AcquireUiResource(REFIID iid, void** output) = 0;
+    virtual HRESULT STDMETHODCALLTYPE AcquireCommandQueue(REFIID iid, void** output) = 0;
+};
+
+// AcquireUiResource returns the original API-visible resource. The consumer must
+// resolve a native resource identity (e.g. supported ReShade unwrap QI) before
+// querying Reno tracking; pointer equality across wrappers must not be assumed.
+// Packet metadata is immutable. It owns the registered UI allocation and the native
+// game/presentation queue, never the swapchain. Content validity is UntilPresent:
+// the consumer must use the newest session/publicationId once on the same native queue,
+// before forwarding that real-frame Present to XeFG. A COM reference alone does
+// not reserve UI contents. Consumers must reject stale/repeated/mismatched packets.
+// Producer clears the property on UI null, actual FFX context destruction and physical
+// swapchain teardown. Transient SDK deactivation/paused interpolation is not UI teardown. Retained consumer GPU leases must retire via queue fences.
diff --git a/src/games/gtav-enhanced/swap_chain_proxy_pixel_shader.ps_6_0.hlsl b/src/games/gtav-enhanced/swap_chain_proxy_pixel_shader.ps_6_0.hlsl
